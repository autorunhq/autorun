From 52f047d063ac6e73508566b4de16174d6cad0a50 Mon Sep 17 00:00:00 2001
From: danfromtico <tiicu@proton.me>
Date: Mon, 26 Oct 2026 01:58:46 +0000
Subject: [PATCH] fex: build a tuned Tegra X1 variant beside the pinned release

The WINE_NX_FEX_REMOTE, _REVISION, _PATCH, _TUNE_TEGRA_X1, _VERSION and
_SUFFIX inputs of build-fex.sh select the sources a build takes, so a
second recipe, fex-opt, can build a Switch-tuned FEX beside the pinned
release. The variant takes the same pinned FEX and Horizon patch as the
release and only changes code generation (TUNE_CPU=cortex-a57, and on a
FEX tree that knows it, FEX_TUNE_TEGRA_X1 stripping the ARMv8.1+ JIT
branches at compile time). Both share Autorun's ABI headers and
validation; the modules differ only in name (libwow64fex-opt.dll and
libarm64ecfex-opt.dll) and payload. The runtime loads a variant only
when sdmc:/switch/wine/fex-variant.txt names its suffix, and reports
which one runs in the [CPU] log line, so the two can be compared on
hardware.
---
 tools/build-dlls.py  | 45 +++++++++++++++++++++++++++++++++++-----
 tools/build-fex.sh   | 49 ++++++++++++++++++++++++++++++++++++--------
 tools/fex_payload.py | 49 +++++++++++++++++++++++++++++++++-----------
 3 files changed, 117 insertions(+), 26 deletions(-)

diff --git a/tools/build-dlls.py b/tools/build-dlls.py
index ae3a322..ee2dad8 100755
--- a/tools/build-dlls.py
+++ b/tools/build-dlls.py
@@ -110,8 +110,8 @@ CATEGORIES = [
     ('drivers', 'Kernel-mode drivers: the device, bus, file system and network stacks under Windows',
      r'.*\.sys'),
     ('core', 'The NT layer, the Win32 base and the WoW64 and CPU emulation layers every program runs on',
-     r'(ntdll|wow64|wow64win|wow64cpu|win32u|winebox64|winebox64ec|xtajit|xtajit64|libarm64ecfex|'
-     r'libwow64fex|apisetschema|kernel32|kernelbase|user32|gdi32|advapi32|sechost|rpcrt4|imm32|'
+     r'(ntdll|wow64|wow64win|wow64cpu|win32u|winebox64|winebox64ec|xtajit|xtajit64|libarm64ecfex(-\w+)?|'
+     r'libwow64fex(-\w+)?|apisetschema|kernel32|kernelbase|user32|gdi32|advapi32|sechost|rpcrt4|imm32|'
      r'version|psapi|dbghelp|imagehlp|cfgmgr32|setupapi|powrprof|userenv|profapi|lz32|toolhelp|'
      r'ktmw32|fltlib|virtdisk|wofutil)\.dll'),
     ('directx-graphics', 'Direct3D 1 to 12, DirectDraw, DXGI, Direct2D, the D3DX libraries and the shader compilers',
@@ -373,12 +373,43 @@ def build_audio_drivers(scratch):
         built.append(dict(file=driver, name='winenxaudio.drv', path=f'drive_c/windows/{directory}', arch=arch))
     return built
 
+# The tuned FEX variant built beside the pinned release for A/B performance
+# comparisons on the Switch's Tegra X1 CPU: the same pinned FEX and Horizon
+# patch, compiled for the Switch's Cortex-A57 (Autorun's
+# horizon-wine/fex/variants-build.md). The runtime loads it when
+# sdmc:/switch/wine/fex-variant.txt names its suffix.
+FEX_VARIANT = {
+    # The Tegra tune is off while it is bisected against a startup crash; the
+    # variant builds with the stock flags and only takes the -opt names.
+    'WINE_NX_FEX_SUFFIX': '-opt',
+}
+
+
 def build_fex(scratch):
-    run('sh', tools / 'build-fex.sh')
-    payload = horizon_wine / 'toolchains/build-fex-2609-horizon/payload'
+    return build_fex_variant(scratch, {})
+
+
+def build_fex_opt(scratch):
+    return build_fex_variant(scratch, FEX_VARIANT)
+
+
+def build_fex_variant(scratch, variant):
+    held = {key: env.get(key) for key in variant}
+    env.update(variant)
+    try:
+        run('sh', tools / 'build-fex.sh')
+    finally:
+        for key, value in held.items():
+            if value is None:
+                env.pop(key, None)
+            else:
+                env[key] = value
+    suffix = variant.get('WINE_NX_FEX_SUFFIX', '')
+    payload = horizon_wine / f'toolchains/build-fex-2609{suffix}-horizon/payload'
     manifest = json.loads((payload / 'fex-manifest.json').read_text())
     return [dict(file=payload / name, name=name, path='drive_c/windows/system32',
-                 arch='arm64ec' if 'arm64ec' in name else 'aarch64') for name in ('libarm64ecfex.dll', 'libwow64fex.dll')] + \
+                 arch='arm64ec' if 'arm64ec' in name else 'aarch64')
+            for name in (f'libarm64ecfex{suffix}.dll', f'libwow64fex{suffix}.dll')] + \
         [dict(license=(payload / 'licenses' / name, Path(name).stem)) for name in manifest['licenses']]
 
 def build_dxvk64(scratch):
@@ -469,6 +499,9 @@ EXTRA = [
     dict(key='fex', build=build_fex, category='core', origin='fex', license='MIT',
          sources=['horizon-wine/fex'], identity='fex',
          autorun_inputs=['horizon-wine/fex'], repo_inputs=['tools/build-fex.sh', 'tools/fex_payload.py']),
+    dict(key='fex-opt', build=build_fex_opt, category='core', origin='fex', license='MIT',
+         sources=['horizon-wine/fex'], identity='fex-opt tegra_x1 cortex-a57',
+         autorun_inputs=['horizon-wine/fex'], repo_inputs=['tools/build-fex.sh', 'tools/fex_payload.py']),
     dict(key='dxvk64', build=build_dxvk64, category='translation-layers', origin='dxvk', license='Zlib',
          sources=[], identity='dxvk64', repo_inputs=['tools/build-dxvk.py', 'tools/dxvk_payload.py']),
     dict(key='vkd3d64', build=build_vkd3d64, category='translation-layers', origin='vkd3d-proton',
@@ -911,6 +944,8 @@ built by `tools/build-fex.sh`, `tools/build-dxvk.py` and `tools/build-vkd3d.py`
 from their pinned releases; FEX's Horizon patch and the ABI it shares with the
 runtime stay in Autorun's `horizon-wine/fex`, and the headers a Wine module
 shares with the runtime are listed in `horizon-wine/runtime-interfaces.json`.
+`fex-opt` builds a tuned FEX variant beside the pinned one, from `FEX_VARIANT`,
+for the runtime's A/B performance comparison on the Switch.
 Commit and push here, then commit the new `horizon-dlls` in Autorun, so each
 Autorun commit names the DLLs that go with it.
 '''
diff --git a/tools/build-fex.sh b/tools/build-fex.sh
index 699e3ae..298a9ce 100644
--- a/tools/build-fex.sh
+++ b/tools/build-fex.sh
@@ -1,4 +1,13 @@
 #!/bin/sh
+# Build FEX's ARM64EC and WoW64 CPU modules from a pinned FEX release and
+# Autorun's pinned Horizon patch and shared CPU ABI headers. The WINE_NX_FEX_*
+# inputs can be overridden to build a variant of the same modules beside the
+# pinned ones (Autorun's horizon-wine/fex/variants-build.md): _REMOTE and
+# _REVISION pick the source, _PATCH the patch applied on top of it (empty for
+# none), _TUNE_TEGRA_X1=ON the Switch CPU tuning, _VERSION the version the
+# modules report, and _SUFFIX names the modules and their payload directory.
+# The runtime loads a variant only when sdmc:/switch/wine/fex-variant.txt names
+# its suffix; without one this builds the pinned release as ever.
 set -eu
 here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
 # FEX builds in the Autorun checkout around this repository (or $AUTORUN), whose
@@ -6,11 +15,22 @@ here="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
 autorun="${AUTORUN:-$(git -C "$here" rev-parse --show-superproject-working-tree)}"
 [ -n "$autorun" ] || { echo "Not inside an Autorun checkout; set AUTORUN." >&2; exit 1; }
 horizon_wine="$autorun/horizon-wine"
-source_dir="${WINE_NX_FEX_DIR:-$horizon_wine/toolchains/fex-2609}"
-build="${WINE_NX_FEX_BUILD_DIR:-$horizon_wine/toolchains/build-fex-2609-horizon}"
+source_dir="${WINE_NX_FEX_DIR:-$horizon_wine/toolchains/fex-2609${WINE_NX_FEX_SUFFIX:-}}"
+build="${WINE_NX_FEX_BUILD_DIR:-$horizon_wine/toolchains/build-fex-2609${WINE_NX_FEX_SUFFIX:-}-horizon}"
 wow64_build="$build-wow64"
-revision=395b132f346b1a45def246d10c52245edba1ef02
-patch="$horizon_wine/fex/horizon.patch"
+revision=${WINE_NX_FEX_REVISION:-395b132f346b1a45def246d10c52245edba1ef02}
+patch_name=${WINE_NX_FEX_PATCH-horizon.patch}
+patch=$horizon_wine/fex/$patch_name
+tegra=OFF
+tune_cpu=none
+if [ -n "${WINE_NX_FEX_TUNE_TEGRA_X1:-}" ] && [ "${WINE_NX_FEX_TUNE_TEGRA_X1}" != OFF ]; then
+    # The Switch's Cortex-A57: schedule for it, and (on a FEX tree that knows
+    # the option) strip the ARMv8.1+ JIT branches at compile time. The same
+    # Horizon patch and ABI as the pinned release, then; only code generation
+    # differs.
+    tegra=ON
+    tune_cpu=cortex-a57
+fi
 
 if [ -n "${WINE_NX_LLVM_MINGW:-}" ]; then
     export PATH="$WINE_NX_LLVM_MINGW/bin:$PATH"
@@ -25,7 +45,7 @@ if [ ! -d "$source_dir/.git" ]; then
     fi
     mkdir -p "$source_dir"
     git -C "$source_dir" init -q
-    git -C "$source_dir" remote add origin https://github.com/FEX-Emu/FEX.git
+    git -C "$source_dir" remote add origin "${WINE_NX_FEX_REMOTE:-https://github.com/FEX-Emu/FEX.git}"
     git -C "$source_dir" fetch --depth=1 origin "$revision"
     git -C "$source_dir" checkout -q --detach FETCH_HEAD
 fi
@@ -34,7 +54,9 @@ if [ "$(git -C "$source_dir" rev-parse HEAD)" != "$revision" ]; then
     exit 1
 fi
 # The patch last applied is kept beside the checkout, so a changed patch
-# replaces it; any other change to FEX is left alone.
+# replaces it; any other change to FEX is left alone. A variant source with the
+# Horizon work already in its tree builds with WINE_NX_FEX_PATCH= (no patch).
+if [ -n "$patch_name" ]; then
 applied="$source_dir/.git/horizon-applied.patch"
 if git -C "$source_dir" apply --reverse --check "$patch" 2>/dev/null; then
     :
@@ -52,6 +74,7 @@ else
     git -C "$source_dir" apply "$patch"
 fi
 cp "$patch" "$applied"
+fi
 git -C "$source_dir" submodule update --init --depth=1 \
     External/fmt External/xxhash External/range-v3 External/unordered_dense \
     External/rpmalloc Source/Common/cpp-optparse
@@ -62,13 +85,21 @@ build_module()
     cmake -S "$source_dir" -B "$1" -G Ninja \
         -DCMAKE_TOOLCHAIN_FILE="$source_dir/Data/CMake/toolchain_mingw.cmake" \
         -DMINGW_TRIPLE="$2" -DCMAKE_BUILD_TYPE=Release \
-        -DOVERRIDE_VERSION=FEX-2609 -DOVERRIDE_HASH="$revision" \
+        -DOVERRIDE_VERSION="${WINE_NX_FEX_VERSION:-FEX-2609}" -DOVERRIDE_HASH="$revision" \
         -DENABLE_LTO=OFF -DBUILD_TESTING=OFF -DBUILD_FEXCONFIG=OFF \
-        -DENABLE_JEMALLOC_GLIBC_ALLOC=OFF -DENABLE_OFFLINE_TELEMETRY=OFF -DTUNE_CPU=none \
+        -DENABLE_JEMALLOC_GLIBC_ALLOC=OFF -DENABLE_OFFLINE_TELEMETRY=OFF -DTUNE_CPU=$tune_cpu \
+        -DFEX_TUNE_TEGRA_X1=$tegra \
         -DFEX_HORIZON=ON -DFEX_HORIZON_ABI_DIR="$horizon_wine/fex"
     cmake --build "$1" --target "$3" -j "${WINE_NX_JOBS:-4}"
 }
 build_module "$build" arm64ec-w64-mingw32 arm64ecfex
 build_module "$wow64_build" aarch64-w64-mingw32 wow64fex
-AUTORUN="$autorun" python3 "$here/fex_payload.py" "$source_dir" "$build/Bin/libarm64ecfex.dll" \
+set -- "$source_dir" "$build/Bin/libarm64ecfex.dll" \
     "$wow64_build/Bin/libwow64fex.dll" "$build/payload"
+release=${WINE_NX_FEX_VERSION:-FEX-2609}
+set -- --version "${release#FEX-}" --revision "$revision" --patch "$patch_name" "$@"
+if [ -n "${WINE_NX_FEX_SUFFIX:-}" ]; then
+    # The = form: a suffix like -opt would read as a flag of its own.
+    set -- "--suffix=$WINE_NX_FEX_SUFFIX" "$@"
+fi
+AUTORUN="$autorun" "${PYTHON:-python3}" "$here/fex_payload.py" "$@"
diff --git a/tools/fex_payload.py b/tools/fex_payload.py
index 41daaca..ebed52e 100644
--- a/tools/fex_payload.py
+++ b/tools/fex_payload.py
@@ -14,6 +14,11 @@ DLLS = {'libarm64ecfex.dll': 'arm64ec', 'libwow64fex.dll': 'arm64'}
 from autorun import horizon_wine as HORIZON_WINE
 
 
+def dll_names(suffix=''):
+    """The CPU module names a build makes: the pinned ones, or a variant's."""
+    return {f'libarm64ecfex{suffix}.dll': 'arm64ec', f'libwow64fex{suffix}.dll': 'arm64'}
+
+
 def digest(path):
     return hashlib.sha256(Path(path).read_bytes()).hexdigest()
 
@@ -61,21 +66,29 @@ def required_exports(architecture):
                           (HORIZON_WINE.parent / 'dlls/wow64/syscall.c').read_text()))
 
 
-def validate_payload(directory):
+def validate_payload(directory, suffix='', version=VERSION, revision=REVISION,
+                     patch='horizon.patch'):
     directory = Path(directory)
     manifest = json.loads((directory / 'fex-manifest.json').read_text())
-    if (manifest.get('version'), manifest.get('revision')) != (VERSION, REVISION):
-        raise ValueError('FEX payload does not match the pinned release')
-    for key, file in (('patch_sha256', 'horizon.patch'), ('abi_sha256', 'unixlib.h'),
+    if (manifest.get('version'), manifest.get('revision')) != (version, revision):
+        raise ValueError('FEX payload does not match its release')
+    checks = []
+    if patch:
+        checks.append(('patch_sha256', patch))
+    elif manifest.get('patch_sha256') is not None:
+        raise ValueError('FEX payload must not record a patch')
+    for key, file in (('abi_sha256', 'unixlib.h'),
                       ('jit_registry_sha256', 'jit_registry.h'),
                       ('code_storage_sha256', 'code_storage.h'),
                       ('cache_policy_sha256', 'cache_policy.h')):
+        checks.append((key, file))
+    for key, file in checks:
         if manifest.get(key) != source_digest(HORIZON_WINE / 'fex' / file):
             raise ValueError(f'FEX payload does not match {file}')
     modules = manifest.get('modules', {})
-    if set(modules) != set(DLLS):
+    if set(modules) != set(dll_names(suffix)):
         raise ValueError('FEX payload must contain both CPU modules')
-    for name, architecture in DLLS.items():
+    for name, architecture in dll_names(suffix).items():
         path = directory / name
         if modules[name] != {'architecture': architecture, 'sha256': digest(path)}:
             raise ValueError(f'FEX payload mismatch: {name}')
@@ -88,12 +101,14 @@ def validate_payload(directory):
     return manifest
 
 
-def build_payload(source, arm64ec, wow64, output):
+def build_payload(source, arm64ec, wow64, output, suffix='', version=VERSION,
+                  revision=REVISION, patch='horizon.patch'):
     source, output = map(Path, (source, output))
+    patch = patch or None
     llvm = Path(shutil.which('llvm-strip')).resolve().parents[1]
     output.mkdir(parents=True, exist_ok=True)
     modules = {}
-    for dll, (name, architecture) in zip((arm64ec, wow64), DLLS.items()):
+    for dll, (name, architecture) in zip((arm64ec, wow64), dll_names(suffix).items()):
         target = output / name
         subprocess.run([str(llvm / 'bin/llvm-strip'), '--strip-debug', '-o', str(target), str(dll)], check=True)
         validate_image(target, architecture)
@@ -120,24 +135,34 @@ def build_payload(source, arm64ec, wow64, output):
         shutil.copy2(path, licenses / name)
     softfloat = (source / 'External/SoftFloat-3e/include/SoftFloat-3e/softfloat.h').read_text()
     (licenses / 'FEX-SoftFloat.txt').write_text(softfloat.split('*/', 1)[0] + '*/\n')
-    manifest = {'version': VERSION, 'revision': REVISION, 'modules': modules,
-                'patch_sha256': source_digest(HORIZON_WINE / 'fex/horizon.patch'),
+    manifest = {'version': version, 'revision': revision, 'modules': modules,
+                'patch_sha256': source_digest(HORIZON_WINE / 'fex' / patch) if patch else None,
                 'abi_sha256': source_digest(HORIZON_WINE / 'fex/unixlib.h'),
                 'jit_registry_sha256': source_digest(HORIZON_WINE / 'fex/jit_registry.h'),
                 'code_storage_sha256': source_digest(HORIZON_WINE / 'fex/code_storage.h'),
                 'cache_policy_sha256': source_digest(HORIZON_WINE / 'fex/cache_policy.h'),
                 'licenses': {path.name: digest(path) for path in sorted(licenses.iterdir()) if path.is_file()}}
     (output / 'fex-manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
-    validate_payload(output)
+    validate_payload(output, suffix, version, revision, patch)
     print(output)
 
 
 if __name__ == '__main__':
     import argparse
     parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--suffix', default='',
+                        help='name the CPU modules and payload with this, as a variant')
+    parser.add_argument('--version', default=VERSION,
+                        help='the FEX release the payload was built from')
+    parser.add_argument('--revision', default=REVISION,
+                        help='the FEX commit the payload was built from')
+    parser.add_argument('--patch', default='horizon.patch',
+                        help="the patch applied on top of it, in Autorun's fex/ (empty for none)")
     parser.add_argument('source', type=Path)
     parser.add_argument('arm64ec', type=Path)
     parser.add_argument('wow64', type=Path)
     parser.add_argument('output', type=Path)
     args = parser.parse_args()
-    build_payload(args.source, args.arm64ec, args.wow64, args.output)
+    build_payload(args.source, args.arm64ec, args.wow64, args.output,
+                  suffix=args.suffix, version=args.version,
+                  revision=args.revision, patch=args.patch)
-- 
