diff --git a/Source/Windows/Common/CRT/HorizonHeap.h b/Source/Windows/Common/CRT/HorizonHeap.h
new file mode 100644
--- /dev/null
+++ b/Source/Windows/Common/CRT/HorizonHeap.h
@@ -0,0 +1,96 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <cerrno>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include "../Priv.h"
+#include "unixlib.h"
+
+namespace FEX::Windows::HorizonHeap {
+NTSTATUS Call(unsigned Function, void* Args);
+struct alignas(16) Header {
+  void* Base;
+  size_t Size;
+};
+
+inline void* Allocate(size_t Size, size_t Alignment = 16, ULONG Flags = 0) {
+  if (!Alignment || (Alignment & (Alignment - 1))) {
+    errno = EINVAL;
+    return nullptr;
+  }
+  if (Alignment < alignof(Header)) Alignment = alignof(Header);
+  const size_t Padding = Alignment - alignof(Header);
+  if (Size > SIZE_MAX - sizeof(Header) - Padding) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  wine_nx_fex_heap Args {Size + sizeof(Header) + Padding, 0, (Flags & HEAP_ZERO_MEMORY) ? 1U : 0U};
+  if (Call(WINE_NX_FEX_HEAP_ALLOC, &Args)) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  void* Base = reinterpret_cast<void*>(Args.pointer);
+  const auto Address = (reinterpret_cast<uintptr_t>(Base) + sizeof(Header) + Alignment - 1) & ~(Alignment - 1);
+  auto* Data = reinterpret_cast<Header*>(Address) - 1;
+  Data->Base = Base;
+  Data->Size = Size;
+  return Data + 1;
+}
+
+inline void Free(void* Pointer) {
+  if (!Pointer) return;
+  wine_nx_fex_heap Args {0, reinterpret_cast<uintptr_t>((static_cast<Header*>(Pointer) - 1)->Base), 0};
+  Call(WINE_NX_FEX_HEAP_FREE, &Args);
+}
+
+inline size_t Size(void* Pointer) {
+  return Pointer ? (static_cast<Header*>(Pointer) - 1)->Size : 0;
+}
+
+inline void* Calloc(size_t Count, size_t Size) {
+  if (Size && Count > SIZE_MAX / Size) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  return Allocate(Count * Size, 16, HEAP_ZERO_MEMORY);
+}
+
+inline void* Reallocate(void* Pointer, size_t NewSize) {
+  if (!Pointer) return Allocate(NewSize);
+  if (!NewSize) {
+    Free(Pointer);
+    return nullptr;
+  }
+  if (NewSize > SIZE_MAX - sizeof(Header)) {
+    errno = ENOMEM;
+    return nullptr;
+  }
+  auto* Data = static_cast<Header*>(Pointer) - 1;
+  if (Data->Base == Data) {
+    wine_nx_fex_heap Args {NewSize + sizeof(Header), reinterpret_cast<uintptr_t>(Data), 0};
+    if (Call(WINE_NX_FEX_HEAP_REALLOC, &Args)) {
+      errno = ENOMEM;
+      return nullptr;
+    }
+    auto* NewData = reinterpret_cast<Header*>(Args.pointer);
+    NewData->Base = NewData;
+    NewData->Size = NewSize;
+    return NewData + 1;
+  }
+  void* Result = Allocate(NewSize);
+  if (Result) {
+    std::memcpy(Result, Pointer, NewSize < Data->Size ? NewSize : Data->Size);
+    Free(Pointer);
+  }
+  return Result;
+}
+
+inline int PosixMemalign(void** Result, size_t Alignment, size_t Size) {
+  if (Alignment < sizeof(void*) || (Alignment & (Alignment - 1))) return EINVAL;
+  void* Pointer = Allocate(Size, Alignment);
+  if (!Pointer) return ENOMEM;
+  *Result = Pointer;
+  return 0;
+}
+} // namespace FEX::Windows::HorizonHeap
