@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: MIT
+#include <FEXCore/Utils/Horizon.h>
+#include <FEXCore/Utils/LogManager.h>
+#include "FEXUnixLib.h"
+#include "unixlib.h"
+#include "jit_registry.h"
+#include <mutex>
+#include <libloaderapi.h>
+
+namespace FEXCore::Allocator {
+namespace {
+WineNX::FEX::JitRegistry Mappings;
+std::mutex MappingLock;
+
+NTSTATUS Call(unsigned Function, void* Args) {
+  return FEX::Windows::UnixLib::Call(static_cast<FEXUnixLibFunctions>(Function), Args);
+}
+}
+
+bool HorizonInitialize() {
+  if (!FEX::Windows::UnixLib::Available() && !FEX::Windows::UnixLib::Init(GetModuleHandleW(L"ntdll.dll"))) return false;
+  wine_nx_fex_query Args {WINE_NX_FEX_ABI_VERSION, sizeof(Args)};
+  return Call(WINE_NX_FEX_QUERY, &Args) == 0;
+}
+
+bool HorizonAttachThread() {
+  return Call(WINE_NX_FEX_ATTACH_THREAD, nullptr) == 0;
+}
+
+void* HorizonAllocateJit(size_t Size) {
+  std::scoped_lock Lock(MappingLock);
+  auto* Entry = Mappings.FindFree();
+  if (!Entry) return nullptr;
+  wine_nx_fex_memory Args {Size, 0, 0};
+  if (Call(WINE_NX_FEX_ALLOC, &Args)) return nullptr;
+  Entry->RW.store(Args.rw, std::memory_order_relaxed);
+  Entry->Size.store(Size, std::memory_order_relaxed);
+  Entry->RX.store(Args.rx, std::memory_order_release);
+  return reinterpret_cast<void*>(Args.rx);
+}
+
+bool HorizonFreeJit(void* Pointer) {
+  std::scoped_lock Lock(MappingLock);
+  auto* Entry = Mappings.FindBase(reinterpret_cast<uintptr_t>(Pointer));
+  if (!Entry) return false;
+  wine_nx_fex_memory Args {Entry->Size.load(), reinterpret_cast<uintptr_t>(Pointer), 0};
+  if (Call(WINE_NX_FEX_FREE, &Args)) ERROR_AND_DIE_FMT("Horizon JIT release failed");
+  Entry->RX.store(0, std::memory_order_release);
+  return true;
+}
+
+void* HorizonWritableAddress(const void* Pointer) {
+  return reinterpret_cast<void*>(Mappings.WritableAddress(reinterpret_cast<uintptr_t>(Pointer)));
+}
+
+void HorizonFlushICache(void* Pointer, size_t Size) {
+  if (!Size) return;
+  if (HorizonWritableAddress(Pointer) == Pointer) {
+    __builtin___clear_cache(static_cast<char*>(Pointer), static_cast<char*>(Pointer) + Size);
+    return;
+  }
+  wine_nx_fex_memory Args {Size, reinterpret_cast<uintptr_t>(Pointer), 0};
+  if (Call(WINE_NX_FEX_FLUSH, &Args)) ERROR_AND_DIE_FMT("Horizon JIT cache flush failed");
+}
+}
+
+namespace FEX::Windows::HorizonHeap {
+NTSTATUS Call(unsigned Function, void* Args) {
+  return UnixLib::Call(static_cast<FEXUnixLibFunctions>(Function), Args);
+}
+}
