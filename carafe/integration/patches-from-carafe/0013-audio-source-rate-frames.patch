+static unsigned int nx_source_capacity(const struct nx_audio_stream *s)
+{
+    return (UINT64)(s->capacity - 1) * s->source_rate / NX_RATE;
+}
+static UINT64 nx_converted_frames(const struct nx_audio_stream *s, UINT64 written)
+{
+    return (written * NX_RATE + s->source_rate - 1) / s->source_rate;
+}
+static UINT64 nx_played_source_frames(const struct nx_audio_stream *s)
+{
+    UINT64 played = (s->played * s->source_rate + NX_RATE - 1) / NX_RATE;
+    return played < s->written ? played : s->written;
+}
+static unsigned int nx_source_padding(const struct nx_audio_stream *s)
+{
+    unsigned int padding = ((UINT64)s->held * s->source_rate + NX_RATE - 1) / NX_RATE;
+    unsigned int capacity = nx_source_capacity(s);
+    return padding < capacity ? padding : capacity;
+}
+static unsigned int nx_source_free(const struct nx_audio_stream *s)
+{
+    unsigned int capacity = nx_source_capacity(s), padding = nx_source_padding(s);
+    return padding < capacity ? capacity - padding : 0;
+}
