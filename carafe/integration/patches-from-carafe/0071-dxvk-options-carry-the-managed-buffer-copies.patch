Carafe: d3d9.managedBufferCopies, the switch for locks of managed buffers that use a copy in Carafe's DXVK build, is
one more key the runtime copies from the program settings into dxvk.conf.
LGPL-2.1-or-later, as the file it changes.

--- a/horizon-wine/source/dxvk_options.c
+++ b/horizon-wine/source/dxvk_options.c
@@ -440,6 +440,9 @@
     OPTION( "d3d9.effectPassMerge",
             "Carafe's DXVK build: the effect thread keeps a pass open when the game begins the same pass again.",
             boolean, 30101, 0, 0, 0, 1, 0, "False" ),
+    OPTION( "d3d9.managedBufferCopies",
+            "Carafe's DXVK build: locks of managed buffers use a copy instead of waiting for the front end thread.",
+            boolean, 30101, 0, 0, 0, 1, 0, "False" ),
 };
 #undef OPTION
 
