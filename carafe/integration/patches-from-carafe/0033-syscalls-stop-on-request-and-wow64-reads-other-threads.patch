+extern __thread volatile int *wine_nx_stop_word;
+
+void wine_nx_stop_point( void )
+{
+    volatile int *word = wine_nx_stop_word;
+    CONTEXT context;
+    int stop;
+
+    if (!word || !(stop = __atomic_load_n( word, __ATOMIC_ACQUIRE ))) return;
+    if (stop & 1)
+    {
+        memset( &context, 0, sizeof(context) );
+        if (!horizon_capture_context( &context )) wait_suspend( &context );
+        stop = __atomic_load_n( word, __ATOMIC_ACQUIRE );
+    }
+    if (stop & 2) NtTerminateThread( GetCurrentThread(), word[1] );
+}
+
+void wine_nx_stop_end( void )
+{
+    for (;;) wine_nx_stop_point();
+}
