Carafe: a sleep stops for a suspend or end request.
NtDelayExecution sleeps on the thread's stop request (0031) instead of in svcSleepThread, so a request wakes
it at once, and then checks the request.
LGPL-2.1-or-later, as the file it changes.

--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -2468,6 +2468,8 @@
  * a few sessions: a sleeping thread could wait there forever (OpenTTD's game
  * loop never woke from its first Sleep). NtDelayExecution sleeps the thread. */
 extern void svcSleepThread( int64_t nano );
+extern void wine_nx_stop_point( void );
+extern void wine_nx_stop_sleep( int64_t nano );
 #endif
 
 /******************************************************************
@@ -2508,7 +2510,11 @@
     if (!timeout || timeout->QuadPart == TIMEOUT_INFINITE)  /* sleep forever */
     {
 #ifdef __SWITCH__
-        for (;;) svcSleepThread( 1000000000LL );
+        for (;;)
+        {
+            wine_nx_stop_sleep( 1000000000LL );
+            wine_nx_stop_point();
+        }
 #else
         for (;;) select( 0, NULL, NULL, NULL, NULL );
 #endif
@@ -2539,7 +2545,8 @@
             if (diff <= 0) break;
 #ifdef __SWITCH__
             /* diff is in microseconds; wake at least hourly to recheck. */
-            svcSleepThread( (diff < 3600000000LL ? diff : 3600000000LL) * 1000 );
+            wine_nx_stop_sleep( (diff < 3600000000LL ? diff : 3600000000LL) * 1000 );
+            wine_nx_stop_point();
 #else
             tv.tv_sec  = diff / 1000000;
             tv.tv_usec = diff % 1000000;
