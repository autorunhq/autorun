+    for (i = 0; i < NX_PROF_PROBES; i++)
+    {
+        struct nx_prof_bucket *bucket = &jit_pcs[(start + i) & (NX_PROF_JIT_PCS - 1)];
+
+        if (bucket->count && bucket->key != pc) continue;
+        bucket->key = pc;
+        bucket->count++;
+        return;
+    }
+}
