+enum carafe_diag_kind
+{
+    CARAFE_DIAG_NEW_THREAD,
+    CARAFE_DIAG_SERVER_START,
+    CARAFE_DIAG_SERVER_END,
+    CARAFE_DIAG_SUSPEND,
+    CARAFE_DIAG_RESUME,
+    CARAFE_DIAG_TERMINATE,
