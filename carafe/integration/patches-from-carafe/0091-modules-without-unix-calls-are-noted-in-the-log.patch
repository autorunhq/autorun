Carafe: a builtin module that asks for its unix calls and gets none is written to the runtime log, the
first 16 of them, with its name and the status, so a DLL that silently falls back to a path the console
lacks shows why.
LGPL-2.1-or-later, as the file it changes.

--- a/dlls/ntdll/unix/virtual.c
+++ b/dlls/ntdll/unix/virtual.c
@@ -1252,6 +1252,22 @@
     }
     server_leave_uninterrupted_section( &virtual_mutex, &sigset );
     if (!status && entry) status = entry();
+#ifdef __SWITCH__
+    if (status)
+    {
+        extern void wine_nx_runtime_trace( const char *msg ) __attribute__((weak));
+        static unsigned int reported;
+        const char *name = wine_nx_module_export_name( module );
+        char message[192];
+
+        if (&wine_nx_runtime_trace && __atomic_add_fetch( &reported, 1, __ATOMIC_RELAXED ) <= 16)
+        {
+            snprintf( message, sizeof(message), "[UNIXLIB] %s at %p has no unix calls%s, status %#x",
+                      name ? name : "?", module, wow ? " for WoW64" : "", (unsigned int)status );
+            wine_nx_runtime_trace( message );
+        }
+    }
+#endif
     return status;
 }
 
