+    device->p_vkGetImageMemoryRequirements( device->host.device, menu->texture, &req );
+    if (!nx_menu_memory( device, &req, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT, &menu->texture_memory ) ||
