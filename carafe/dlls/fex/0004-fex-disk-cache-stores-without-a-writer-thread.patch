+  static uint32_t PayloadCrc(std::span<const std::span<const uint8_t>> Chunks) {
+    XXH3_state_t State;
+    XXH3_64bits_reset(&State);
+    for (const std::span<const uint8_t>& Chunk : Chunks) {
+      XXH3_64bits_update(&State, Chunk.data(), Chunk.size());
+    }
+    const uint32_t Crc = (uint32_t)XXH3_64bits_digest(&State);
+    return Crc ? Crc : 1;
+  }
