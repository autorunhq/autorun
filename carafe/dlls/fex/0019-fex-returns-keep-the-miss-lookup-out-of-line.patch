+void Arm64JITCore::EmitReturnLookup(ARMEmitter::Register RipReg) {
+  ARMEmitter::ForwardLabel Found;
+
+  if (ProfileStats()) {
+    ARMEmitter::ForwardLabel NoStats;
+    ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, Thread));
+    ldr(TMP1, TMP1, offsetof(FEXCore::Core::InternalThreadState, ThreadStats));
+    (void)cbz(ARMEmitter::Size::i64Bit, TMP1, &NoStats);
+    ldr(TMP2, TMP1, offsetof(FEXCore::SHMStats::ThreadStats, AccumulatedReturnMissCount));
+    add(ARMEmitter::Size::i64Bit, TMP2, TMP2, 1);
+    str(TMP2, TMP1, offsetof(FEXCore::SHMStats::ThreadStats, AccumulatedReturnMissCount));
+    (void)Bind(&NoStats);
+  }
+
+  eor(ARMEmitter::Size::i64Bit, TMP1, RipReg, RipReg, ARMEmitter::ShiftType::LSL, FEXCore::ilog2(sizeof(LookupCache::LookupCacheEntry)));
+  ldr(TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.L1Mask));
+  and_(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1);
+  ldr(TMP1, STATE, offsetof(FEXCore::Core::CpuStateFrame, State.L1Pointer));
+  add(TMP1, TMP1, TMP2);
+  ldp<ARMEmitter::IndexType::OFFSET>(TMP2, TMP1, TMP1, 0);
+  sub(TMP1, TMP1, RipReg.X());
+  (void)cbz(ARMEmitter::Size::i64Bit, TMP1, &Found);
+  ldr(TMP2, STATE, offsetof(FEXCore::Core::CpuStateFrame, Pointers.DispatcherLoopTop));
+  str(RipReg.X(), STATE, offsetof(FEXCore::Core::CpuStateFrame, State.rip));
+  (void)Bind(&Found);
+  ret(TMP2);
+}
