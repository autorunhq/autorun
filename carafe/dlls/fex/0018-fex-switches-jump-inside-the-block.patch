+DEF_OP(JumpTableEntry) {
+  auto Op = IROp->C<IR::IROp_JumpTableEntry>();
+
+  PendingJumpTableCases.push_back({JumpTarget(Op->TargetBlock), Op->Index, Op->GuestRIP});
+}
+
+DEF_OP(JumpTableBranch) {
+  auto Op = IROp->C<IR::IROp_JumpTableBranch>();
+
+  fextl::vector<PendingJumpTableCase> Cases;
+  for (const auto& Case : PendingJumpTableCases) {
+    if (!Case.Target->Backward.Location && Case.Index < Op->Count) {
+      Cases.push_back(Case);
+    }
+  }
+  PendingJumpTableCases.clear();
+
+  if (Cases.empty()) {
+    return;
+  }
+
+  auto IndexReg = GetReg(Op->Index);
+  auto RipReg = GetReg(Op->NewRIP);
+
+  constexpr size_t MAX_COMPARE_CHAIN = 4;
+  fextl::vector<const PendingJumpTableCase*> Distinct;
+  for (const auto& Case : Cases) {
+    const bool Seen = std::any_of(Distinct.begin(), Distinct.end(), [&](const auto* Other) { return Other->GuestRIP == Case.GuestRIP; });
+    if (!Seen) {
+      Distinct.push_back(&Case);
+    }
+  }
+
+  if (Distinct.size() <= MAX_COMPARE_CHAIN) {
+    for (const auto* Case : Distinct) {
+      LoadConstant(ARMEmitter::Size::i32Bit, TMP1, Case->GuestRIP);
+      sub(ARMEmitter::Size::i32Bit, TMP1, RipReg, TMP1);
+      cbz_OrRestart(ARMEmitter::Size::i32Bit, TMP1, Case->Target);
+    }
+    return;
+  }
+
+  ARMEmitter::ForwardLabel Miss;
+
+  auto& Table = PendingJumpTables.emplace_back();
+  Table.Count = Op->Count;
+  Table.Cases = std::move(Cases);
+
+  and_(ARMEmitter::Size::i32Bit, TMP1, IndexReg, Op->Count - 1);
+  (void)adr(TMP2, &Table.Label);
+  add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP1, ARMEmitter::ShiftType::LSL, 3);
+  ldpsw<ARMEmitter::IndexType::OFFSET>(TMP1, TMP3, TMP2, 0);
+  sub(ARMEmitter::Size::i32Bit, TMP1, TMP1, RipReg);
+  (void)cbnz(ARMEmitter::Size::i32Bit, TMP1, &Miss);
+  add(ARMEmitter::Size::i64Bit, TMP2, TMP2, TMP3);
+  br(TMP2);
+  (void)Bind(&Miss);
+  PendingJumpTables.back().Miss = GetCursorAddress<uint8_t*>();
+}
