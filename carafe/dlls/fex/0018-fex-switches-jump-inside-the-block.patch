+void OpDispatchBuilder::JumpTableExit(Ref NewRIP, const FEXCore::Frontend::Decoder::JumpTable& Table) {
+  fextl::vector<std::pair<uint32_t, Ref>> Cases;
+  for (uint32_t i = 0; i < Table.Targets.size(); ++i) {
+    const auto Target = Table.Targets[i];
+    if (!Target) {
+      continue;
+    }
+    if (auto Block = JumpTargets.find(Target); Block != JumpTargets.end()) {
+      Cases.emplace_back(i, Block->second.BlockEntry);
+    }
+  }
+
+  if (Cases.empty()) {
+    ExitFunction(NewRIP);
+    return;
+  }
+
+  auto Index = LoadGPRRegister(Table.IndexReg);
+  FlushRegisterCache();
+  for (const auto& [i, Block] : Cases) {
+    _JumpTableEntry(Block, i, Table.Targets[i]);
+  }
+  const auto Count = std::bit_ceil(std::max<uint32_t>(Table.Targets.size(), 2));
+  _JumpTableBranch(Index, NewRIP, Count);
+  ExitFunction(NewRIP);
+}
