+std::optional<uint32_t> Decoder::ReadReadOnlyGuest(uint64_t Address, uint8_t Size) const {
+  if (ExecutableRangeWritable || Address < ExecutableRangeBase || Address + Size < Address || Address + Size > ExecutableRangeEnd) {
+    return std::nullopt;
+  }
+
+  uint32_t Value {};
+  memcpy(&Value, reinterpret_cast<const void*>(Address), Size);
+  return Value;
+}
+
+void Decoder::RecordSwitchBound(uint64_t NumInstructions) {
+  constexpr uint64_t MAX_JUMP_TABLE_ENTRIES = 256;
+
+  if (NumInstructions < 2 || !JumpTablesAllowed()) {
+    return;
+  }
+
+  const bool Above = DecodeInst->OP == 0x77 || DecodeInst->OP == 0x87;
+  const bool AboveOrEqual = DecodeInst->OP == 0x73 || DecodeInst->OP == 0x83;
+  if (!Above && !AboveOrEqual) {
+    return;
+  }
+
+  const auto Compare = std::prev(DecodeInst);
+  const auto* Bytes = reinterpret_cast<const uint8_t*>(Compare->PC);
+  uint8_t Reg {};
+  int64_t Limit {};
+  if (Compare->InstSize == 3 && Bytes[0] == 0x83 && (Bytes[1] & 0xF8) == 0xF8) {
+    Reg = Bytes[1] & 7;
+    Limit = static_cast<int8_t>(Bytes[2]);
+  } else if (Compare->InstSize == 6 && Bytes[0] == 0x81 && (Bytes[1] & 0xF8) == 0xF8) {
+    uint32_t Imm {};
+    memcpy(&Imm, Bytes + 2, sizeof(Imm));
+    Reg = Bytes[1] & 7;
+    Limit = Imm;
+  } else if (Compare->InstSize == 5 && Bytes[0] == 0x3D) {
+    uint32_t Imm {};
+    memcpy(&Imm, Bytes + 1, sizeof(Imm));
+    Reg = FEXCore::X86State::REG_RAX;
+    Limit = Imm;
+  } else {
+    return;
+  }
+
+  const int64_t Count = Above ? Limit + 1 : Limit;
+  if (Count <= 0 || Count > static_cast<int64_t>(MAX_JUMP_TABLE_ENTRIES)) {
+    return;
+  }
+
+  const uint64_t FallThrough = (DecodeInst->PC + DecodeInst->InstSize) & 0xFFFFFFFFU;
+  SwitchBounds[FallThrough] = {.Reg = Reg, .Count = static_cast<uint32_t>(Count)};
+}
+
+void Decoder::RecordJumpTable(uint64_t BlockEntry, uint64_t NumInstructions) {
+  constexpr uint64_t MAX_FORWARD_BRANCH_DIST = FEXCore::Utils::FEX_PAGE_SIZE * 4;
+
+  if (!JumpTablesAllowed() || DecodeInst->InstSize != 7) {
+    return;
+  }
+
+  const auto* Bytes = reinterpret_cast<const uint8_t*>(DecodeInst->PC);
+  if (Bytes[0] != 0xFF || Bytes[1] != 0x24 || (Bytes[2] & 0xC7) != 0x85) {
+    return;
+  }
+
+  const uint8_t IndexReg = (Bytes[2] >> 3) & 7;
+  if (IndexReg == FEXCore::X86State::REG_RSP) {
+    return;
+  }
+
+  uint32_t TableAddress {};
+  memcpy(&TableAddress, Bytes + 3, sizeof(TableAddress));
+
+  auto Bound = SwitchBounds.find(BlockEntry);
+  if (Bound == SwitchBounds.end()) {
+    return;
+  }
+
+  uint32_t Count {};
+  if (NumInstructions == 1) {
+    if (Bound->second.Reg != IndexReg) {
+      return;
+    }
+    Count = Bound->second.Count;
+  } else if (NumInstructions == 2) {
+    const auto Narrow = std::prev(DecodeInst);
+    const auto* NarrowBytes = reinterpret_cast<const uint8_t*>(Narrow->PC);
+    if (Narrow->InstSize != 7 || NarrowBytes[0] != 0x0F || NarrowBytes[1] != 0xB6 || (NarrowBytes[2] >> 6) != 2) {
+      return;
+    }
+
+    const uint8_t NarrowDest = (NarrowBytes[2] >> 3) & 7;
+    const uint8_t NarrowIndex = NarrowBytes[2] & 7;
+    if (NarrowIndex == FEXCore::X86State::REG_RSP || NarrowDest != IndexReg || Bound->second.Reg != NarrowIndex) {
+      return;
+    }
+
+    uint32_t ByteTable {};
+    memcpy(&ByteTable, NarrowBytes + 3, sizeof(ByteTable));
+    for (uint32_t i = 0; i < Bound->second.Count; ++i) {
+      auto Case = ReadReadOnlyGuest(uint64_t {ByteTable} + i, 1);
+      if (!Case) {
+        return;
+      }
+      Count = std::max(Count, *Case + 1);
+    }
+  } else {
+    return;
+  }
+
+  const uint64_t InstEnd = DecodeInst->PC + DecodeInst->InstSize;
+  const uint64_t TargetLimit = std::min(InstEnd + MAX_FORWARD_BRANCH_DIST, SectionMaxAddress);
+
+  JumpTable Table {.IndexReg = IndexReg};
+  Table.Targets.resize(Count);
+  bool HasTarget = false;
+  for (uint32_t i = 0; i < Count; ++i) {
+    auto Target = ReadReadOnlyGuest(uint64_t {TableAddress} + uint64_t {i} * 4, 4);
+    if (!Target) {
+      return;
+    }
+    if (*Target > DecodeInst->PC && *Target < TargetLimit) {
+      Table.Targets[i] = *Target;
+      HasTarget = true;
+    }
+  }
+
+  if (!HasTarget) {
+    return;
+  }
+
+  const uint64_t JumpPC = DecodeInst->PC;
+  for (auto Target : Table.Targets) {
+    if (Target) {
+      AddBranchTarget(Target);
+    }
+  }
+
+  BlockInfo.JumpTables[JumpPC] = std::move(Table);
+}
