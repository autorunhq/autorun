+  FEXCore::HLE::ExecutableRangeInfo QueryGuestReadableRange(uint64_t Address) override {
+    constexpr ULONG Readable = PAGE_READONLY | PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READ | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY;
+    MEMORY_BASIC_INFORMATION Info;
+    if (NtQueryVirtualMemory(NtCurrentProcess(), reinterpret_cast<void*>(Address), MemoryBasicInformation, &Info, sizeof(Info), nullptr) ||
+        Info.State != MEM_COMMIT || (Info.Protect & (PAGE_GUARD | PAGE_NOACCESS)) || !(Info.Protect & Readable)) {
+      return {};
+    }
+    const bool Writable = Info.Protect & (PAGE_READWRITE | PAGE_WRITECOPY | PAGE_EXECUTE_READWRITE | PAGE_EXECUTE_WRITECOPY);
+    return {reinterpret_cast<uint64_t>(Info.BaseAddress), Info.RegionSize, Writable};
+  }
+
   void PreCompile() override {
     Wow64ProcessPendingCrossProcessItems();
   }
