Carafe: FIST and FISTP rounding by the guest's FCW (X87ConversionRounding) convert in one instruction per rounding
mode: fcvtns, fcvtms, fcvtps and fcvtzs, instead of frint followed by fcvtzs, and with X87SinglePrecision they convert
the float32 stack value itself instead of widening it to a double first. On the A57 that takes frint (5 cycles) and
the fcvt (5 cycles) off the dependency chain of every float-to-integer conversion. Rounding control 0 now means
round to nearest, as on x87, whatever rounding mode SSE left in FPCR.
MIT, as the files it changes.

--- a/FEXCore/Source/Interface/Core/JIT/ALUOps.cpp
+++ b/FEXCore/Source/Interface/Core/JIT/ALUOps.cpp
@@ -1477,6 +1477,55 @@ DEF_OP(Float_ToGPR_ZS) {
   }
 }
 
+DEF_OP(Float_ToGPR_R) {
+  auto Op = IROp->C<IR::IROp_Float_ToGPR_R>();
+
+  const auto Size = ConvertSize(IROp);
+  ARMEmitter::Register Dst = GetReg(Node);
+  ARMEmitter::VRegister Src = GetVReg(Op->Scalar);
+  const bool Double = Op->SrcElementSize == IR::OpSize::i64Bit;
+
+  switch (Op->Round) {
+  case IR::RoundMode::Nearest:
+    if (Double) {
+      fcvtns(Size, Dst, Src.D());
+    } else {
+      fcvtns(Size, Dst, Src.S());
+    }
+    break;
+  case IR::RoundMode::NegInfinity:
+    if (Double) {
+      fcvtms(Size, Dst, Src.D());
+    } else {
+      fcvtms(Size, Dst, Src.S());
+    }
+    break;
+  case IR::RoundMode::PosInfinity:
+    if (Double) {
+      fcvtps(Size, Dst, Src.D());
+    } else {
+      fcvtps(Size, Dst, Src.S());
+    }
+    break;
+  case IR::RoundMode::TowardsZero:
+    if (Double) {
+      fcvtzs(Size, Dst, Src.D());
+    } else {
+      fcvtzs(Size, Dst, Src.S());
+    }
+    break;
+  case IR::RoundMode::Host:
+    if (Double) {
+      frinti(VTMP1.D(), Src.D());
+      fcvtzs(Size, Dst, VTMP1.D());
+    } else {
+      frinti(VTMP1.S(), Src.S());
+      fcvtzs(Size, Dst, VTMP1.S());
+    }
+    break;
+  }
+}
