+bool ContextImpl::IsHostPCInBlock(FEXCore::Core::InternalThreadState* Thread, uint64_t BlockBegin, uint64_t HostPC) const {
+  if (BlockBegin == 0 || BlockBegin > HostPC || !IsAddressInCodeBuffer(Thread, BlockBegin)) {
+    return false;
+  }
+
+  const auto Header = reinterpret_cast<const CPU::CPUBackend::JITCodeHeader*>(BlockBegin);
+  const uint64_t TailAddress = BlockBegin + Header->OffsetToBlockTail;
+  if (TailAddress <= BlockBegin || !IsAddressInCodeBuffer(Thread, TailAddress)) {
+    return false;
+  }
+
+  const auto Tail = reinterpret_cast<const CPU::CPUBackend::JITCodeTail*>(TailAddress);
+  return HostPC < BlockBegin + Tail->Size;
+}
+
+void ContextImpl::SyncBlockHeader(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC) {
+#ifndef ARCHITECTURE_arm64ec
+  constexpr uint64_t MAX_SCAN = 1024 * 1024;
+  constexpr uint32_t ADR_X0_MASK = 0x9F00001F;
+  constexpr uint32_t ADR_X0 = 0x10000000;
+  constexpr uint32_t STR_X0_HEADER = 0xF9000000 | ((offsetof(FEXCore::Core::CPUState, InlineJITBlockHeader) / 8) << 10) | (28 << 5);
+
+  if (!FEXCore::Config::Get_SLIMRETURNPOINTS()) {
+    return;
+  }
+
+  auto& State = Thread->CurrentFrame->State;
+  if (IsHostPCInBlock(Thread, State.InlineJITBlockHeader, HostPC) || !IsAddressInCodeBuffer(Thread, HostPC)) {
+    return;
+  }
+
+  const uint64_t Limit = HostPC > MAX_SCAN ? HostPC - MAX_SCAN : 0;
+  uint64_t CheckedPage = ~0ULL;
+  for (uint64_t Address = (HostPC & ~3ULL) - 4; Address > Limit; Address -= 4) {
+    const uint64_t Page = Address & FEXCore::Utils::FEX_PAGE_MASK;
+    if (Page != CheckedPage) {
+      if (!IsAddressInCodeBuffer(Thread, Address)) {
+        return;
+      }
+      CheckedPage = Page;
+    }
+
+    const auto Words = reinterpret_cast<const uint32_t*>(Address);
+    if ((Words[0] & ADR_X0_MASK) != ADR_X0 || Words[1] != STR_X0_HEADER) {
+      continue;
+    }
+
+    const uint64_t Imm = (((Words[0] >> 5) & 0x7FFFF) << 2) | ((Words[0] >> 29) & 3);
+    const int64_t Offset = static_cast<int64_t>(Imm << 43) >> 43;
+    const uint64_t BlockBegin = Address + Offset;
+    if (IsHostPCInBlock(Thread, BlockBegin, HostPC)) {
+      State.InlineJITBlockHeader = BlockBegin;
+      return;
+    }
+  }
+#endif
+}
+
 uint64_t ContextImpl::RestoreRIPFromHostPC(FEXCore::Core::InternalThreadState* Thread, uint64_t HostPC) {
