+uint64_t Arm64JITCore::IndirectCallLink(FEXCore::Core::CpuStateFrame* Frame, IndirectCallCacheRecord* Record) {
+  auto Thread = Frame->Thread;
+  const uint64_t GuestRip = Frame->State.rip;
+  if (Thread->CurrentFrame->State.flags[X86State::RFLAG_TF_RAW_LOC]) {
+    return Frame->Pointers.DispatcherLoopTop;
+  }
+
+  uintptr_t HostCode {};
+  {
+    auto lk_inval =
+      GuardSignalDeferringSection<std::shared_lock>(static_cast<Context::ContextImpl*>(Thread->CTX)->CodeInvalidationMutex, Thread);
+    HostCode = Thread->LookupCache->FindBlock(Thread, GuestRip);
+  }
+  if (!HostCode) {
+    auto CodeBuffer = static_cast<Arm64JITCore*>(Thread->CPUBackend.get())->CurrentCodeBuffer;
+    HostCode = static_cast<Context::ContextImpl*>(Thread->CTX)->CompileBlock(Frame, GuestRip, 0);
+    if (Thread->LookupCache->Shared != CodeBuffer->LookupCache.get()) {
+      return HostCode;
+    }
+  }
+
+  auto lk_inval = GuardSignalDeferringSection<std::shared_lock>(static_cast<Context::ContextImpl*>(Thread->CTX)->CodeInvalidationMutex, Thread);
+  auto lk = Thread->LookupCache->AcquireWriteLock();
+  if (std::atomic_ref<uint64_t>(Record->GuestRIP).load(std::memory_order::acquire) != 0) {
+    return HostCode;
+  }
+
+  std::atomic_ref<uint64_t>(*ARMEmitter::Emitter::WritableAddress(&Record->HostCode)).store(HostCode, std::memory_order::relaxed);
+  std::atomic_ref<uint64_t>(*ARMEmitter::Emitter::WritableAddress(&Record->GuestRIP)).store(GuestRip, std::memory_order::release);
+#ifdef FEX_HORIZON
+  ARMEmitter::Emitter::ClearICache(Record, sizeof(*Record));
+#endif
+  Thread->LookupCache->AddBlockLink(
+    GuestRip, reinterpret_cast<FEXCore::Context::ExitFunctionLinkData*>(Record),
+    [](FEXCore::Context::ExitFunctionLinkData* Link) {
+      auto Cached = reinterpret_cast<IndirectCallCacheRecord*>(Link);
+      std::atomic_ref<uint64_t>(*ARMEmitter::Emitter::WritableAddress(&Cached->GuestRIP)).store(0, std::memory_order::release);
+    },
+    lk);
+  return HostCode;
+}
