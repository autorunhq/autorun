+void DeadFlagCalculationEliminination::FoldCarryInvert(IREmitter* IREmit, IRListView& CurrentIR, Ref Block) {
+  struct Fold {
+    Ref Producer;
+    IROp_Header* ProducerOp;
+    Ref Invert;
+  };
+
+  fextl::vector<Fold> Folds;
+  Ref Producer = nullptr;
+  IROp_Header* ProducerOp = nullptr;
+
+  for (auto [CodeNode, IROp] : CurrentIR.GetCode(Block)) {
+    if (IROp->Op == OP_CARRYINVERT) {
+      if (Producer) {
+        Folds.push_back({Producer, ProducerOp, CodeNode});
+      }
+
+      Producer = nullptr;
+    } else if (IROp->Op == OP_TESTNZ || (IROp->Op == OP_ANDWITHFLAGS && IROp->Size >= OpSize::i32Bit)) {
+      Producer = CodeNode;
+      ProducerOp = IROp;
+    } else {
+      const auto Info = Classify(IROp);
+      if (((Info.Read() | Info.Write()) & FLAG_NZCV) || ImplicitFlagClobber(IROp->Op) || IROp->Op == OP_TESTZ) {
+        Producer = nullptr;
+      }
+    }
+  }
+
+  for (auto& F : Folds) {
+    const auto Size = F.ProducerOp->Size;
+    IREmit->SetWriteCursor(F.Producer);
+
+    if (F.ProducerOp->Op == OP_ANDWITHFLAGS) {
+      F.ProducerOp->Op = OP_AND;
+      IREmit->_SubNZCV(Size, F.Producer, IREmit->_InlineConstant(0));
+    } else {
+      const auto WideSize = std::max(Size, OpSize::i32Bit);
+      Ref Src1 = CurrentIR.GetNode(F.ProducerOp->Args[0]);
+      Ref Src2 = CurrentIR.GetNode(F.ProducerOp->Args[1]);
+      Ref Value = Src1 == Src2 ? Src1 : IREmit->_And(WideSize, Src1, Src2);
+
+      if (Size < OpSize::i32Bit) {
+        Value = IREmit->_Lshl(OpSize::i32Bit, Value, IREmit->_InlineConstant(32 - IR::OpSizeAsBits(Size)));
+      }
+
+      IREmit->_SubNZCV(WideSize, Value, IREmit->_InlineConstant(0));
+      IREmit->Remove(F.Producer);
+    }
+
+    IREmit->Remove(F.Invert);
+  }
+}
