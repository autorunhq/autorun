+  bool D3D9FrontEnd::CopiesLock(D3D9CommonBuffer* pBuffer, UINT OffsetToLock, UINT SizeToLock, DWORD Flags) {
+    if (!m_managedCopies)
+      return false;
+    const D3D9_BUFFER_DESC* desc = pBuffer->Desc();
+    if (desc->Pool != D3DPOOL_MANAGED || desc->Size > CopiedBufferMax || OffsetToLock >= desc->Size)
+      return false;
+    uint32_t size = SizeToLock == 0 ? desc->Size - OffsetToLock : std::min<UINT>(SizeToLock, desc->Size - OffsetToLock);
+    if (!(Flags & D3DLOCK_READONLY) && size > CopiedLockMax)
+      return false;
+    D3D9FrontEndStaging& staging = pBuffer->m_frontEndStaging[m_index];
+    if (staging.stale.exchange(0u) != 0)
+      staging.copied = false;
+    if (!staging.copied) {
+      if (!staging.locked) {
+        staging.locked = true;
+        return false;
+      }
+      void* data = nullptr;
+      if (FAILED(m_device->LockBuffer(pBuffer, 0, 0, &data, D3DLOCK_READONLY)) || data == nullptr)
+        return false;
+      staging.memory.resize(std::max<size_t>(staging.memory.size(), desc->Size));
+      std::memcpy(staging.memory.data(), data, desc->Size);
+      m_device->UnlockBuffer(pBuffer);
+      staging.copied = true;
+      m_statCopies++;
+    }
+    return true;
+  }
