+  void D3D9DeviceEx::CountSyncFrame(uint64_t frames) {
+    static const char* const names[] = {
+      "buffer locks with discard", "with no overwrite", "read only", "with no flag", "KB locked",
+      "texture locks", "of them in the default pool", "KB drawn from memory", "KB of vertex shader constants",
+      "query reads", "not ready", "render target reads", "state queries", "resources created",
+    };
+    static const bool kilobytes[] = {
+      false, false, false, false, true, false, false, true, true, false, false, false, false, false,
+    };
+
+    DxvkStatCounters counters = m_dxvkDevice->getStatCounters();
+    std::array<uint64_t, 4> sync = {
+      counters.getCtr(DxvkStatCounter::CsSyncCount), counters.getCtr(DxvkStatCounter::CsSyncTicks),
+      counters.getCtr(DxvkStatCounter::GpuSyncCount), counters.getCtr(DxvkStatCounter::GpuSyncTicks),
+    };
+
+    std::string text = str::format("[D3D9 sync] in ", frames, " frames:");
+    for (uint32_t i = 0; i < uint32_t(D3D9Sync::Count); i++)
+      text += str::format(i ? ", " : " ", names[i], " ", kilobytes[i] ? m_syncCounts[i] / 1024 : m_syncCounts[i]);
+    text += str::format(", waits for the CS thread ", sync[0] - m_syncSeen[0], " (", sync[1] - m_syncSeen[1],
+      " us), waits for the GPU ", sync[2] - m_syncSeen[2], " (", sync[3] - m_syncSeen[3], " us)");
+    Logger::info(text);
+    m_syncCounts = { };
+    m_syncSeen = sync;
+  }
