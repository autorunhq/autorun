+  Sleep::TimePoint Sleep::sleep(TimePoint t0, TimerDuration duration, uint32_t pacing) {
+    if (!pacing)
+      return sleep(t0, duration);
+
+    if (duration <= TimerDuration::zero())
+      return t0;
+
+    if (!m_initialized.load())
+      initialize();
+
+    if (pacing == 1u) {
+      systemSleep(duration);
+      return dxvk::high_resolution_clock::now();
+    }
+
+    if (pacing == 3u)
+      return spin(t0, duration);
+
+    TimerDuration margin = std::chrono::duration_cast<TimerDuration>(std::chrono::microseconds(150));
+    TimerDuration step = std::chrono::duration_cast<TimerDuration>(std::chrono::milliseconds(1));
+    TimerDuration remaining = duration;
+    TimePoint t1 = t0;
+
+    while (remaining > margin) {
+      systemSleep(std::min(remaining - margin, step));
+      t1 = dxvk::high_resolution_clock::now();
+      remaining -= std::chrono::duration_cast<TimerDuration>(t1 - t0);
+      t0 = t1;
+    }
+
+    return spin(t0, remaining);
+  }
+
+
+  Sleep::TimePoint Sleep::spin(TimePoint t0, TimerDuration duration) {
+    TimerDuration remaining = duration;
+    TimePoint t1 = t0;
+
+    while (remaining > TimerDuration::zero()) {
+      t1 = dxvk::high_resolution_clock::now();
+      remaining -= std::chrono::duration_cast<TimerDuration>(t1 - t0);
+      t0 = t1;
+    }
+
+    return t1;
+  }
+
+
