+    uintptr_t FindWineTable(uintptr_t base, const Queued* pQueued, size_t QueuedCount, uint32_t* pSlots) {
+      std::vector<Section> sections = Sections(base);
+      uintptr_t picked = 0;
+      uint32_t candidates = 0;
+      for (const auto& s : sections) {
+        if (s.code)
+          continue;
+        for (uintptr_t p = (s.begin + 3) & ~uintptr_t(3); p + 4 * WineMaxSlots <= s.end; p += 4) {
+          auto entries = reinterpret_cast<const uint32_t*>(p);
+          bool fits = true;
+          for (size_t n = 0; n < QueuedCount && fits; n++) {
+            uint32_t function = entries[pQueued[n].slot];
+            fits = InCode(sections, function) && ReturnBytes(function) == int(4 * (pQueued[n].args + 1));
+          }
+          if (!fits)
+            continue;
+          uint32_t run = 0;
+          while (run < WineMaxSlots && InCode(sections, entries[run]))
+            run++;
+          if (run < WineMinSlots)
+            continue;
+          candidates++;
+          picked = p;
+          *pSlots = run;
+        }
+      }
+      return candidates == 1 ? picked : 0;
+    }
