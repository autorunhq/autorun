Carafe: with dxvk.allCompilerWorkers = True (or DXVK_ALL_CORES=1, DXVK-Sarek's switch), every compiler worker
takes jobs of every priority. On three cores DXVK otherwise leaves the shader libraries and the optimized pipelines
to one worker of three, and keeps the other two for high-priority jobs only.
Zlib, as the files it changes.

diff -ruN a/src/dxvk/dxvk_options.cpp b/src/dxvk/dxvk_options.cpp
--- a/src/dxvk/dxvk_options.cpp
+++ b/src/dxvk/dxvk_options.cpp
@@ -29,6 +29,7 @@
     tilerMode             = config.getOption<Tristate>("dxvk.tilerMode",              Tristate::Auto);
 
     skipRedundantPipelineBinds = config.getOption<bool>("dxvk.skipRedundantPipelineBinds", false);
+    allCompilerWorkers = config.getOption<bool>("dxvk.allCompilerWorkers", false);
 
     std::string rateMethod = env::getEnvVar("DXVK_FRAME_RATE_METHOD");
 
diff -ruN a/src/dxvk/dxvk_options.h b/src/dxvk/dxvk_options.h
