+
+  HRESULT D3D9FrontEnd::StretchRect(
+          IDirect3DSurface9*   pSourceSurface,
+    const RECT*                pSourceRect,
+          IDirect3DSurface9*   pDestSurface,
+    const RECT*                pDestRect,
+          D3DTEXTUREFILTERTYPE Filter) {
+    D3D9Surface* src = static_cast<D3D9Surface*>(pSourceSurface);
+    D3D9Surface* dst = static_cast<D3D9Surface*>(pDestSurface);
+    if (unlikely(src == nullptr || dst == nullptr || src == dst
+              || src->GetCommonTexture()->Desc()->Pool != D3DPOOL_DEFAULT
+              || dst->GetCommonTexture()->Desc()->Pool != D3DPOOL_DEFAULT))
+      return D3DERR_INVALIDCALL;
+    RefPrivate<D3D9Surface>(src, true);
+    RefPrivate<D3D9Surface>(dst, true);
+    auto args = reinterpret_cast<StretchArgs*>(Allocate(D3D9FrontEndOp::StretchRect, sizeof(StretchArgs)));
+    args->src = src;
+    args->dst = dst;
+    args->hasSrcRect = pSourceRect != nullptr;
+    args->hasDstRect = pDestRect != nullptr;
+    args->srcRect = pSourceRect != nullptr ? *pSourceRect : RECT();
+    args->dstRect = pDestRect != nullptr ? *pDestRect : RECT();
+    args->filter = Filter;
+    return D3D_OK;
+  }
