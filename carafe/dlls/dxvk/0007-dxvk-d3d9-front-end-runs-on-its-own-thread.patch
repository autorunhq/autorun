+  HRESULT D3D9FrontEnd::SetDepthStencilSurface(IDirect3DSurface9* pNewZStencil) {
+    D3D9Surface* surface = static_cast<D3D9Surface*>(pNewZStencil);
+    if (unlikely(surface != nullptr && !(surface->GetCommonTexture()->Desc()->Usage & D3DUSAGE_DEPTHSTENCIL)))
+      return D3DERR_INVALIDCALL;
+    Refresh();
+    m_shadow.depthStencil = surface;
+    RefPrivate<D3D9Surface>(surface, true);
+    reinterpret_cast<ObjectArgs*>(Allocate(D3D9FrontEndOp::DepthStencil, sizeof(ObjectArgs)))->object = surface;
+    return D3D_OK;
