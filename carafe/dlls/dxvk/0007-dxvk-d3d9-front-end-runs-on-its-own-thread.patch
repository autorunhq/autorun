+  HRESULT D3D9FrontEnd::DrawUp(
+          D3DPRIMITIVETYPE PrimitiveType,
+          UINT             PrimitiveCount,
+    const void*            pVertexStreamZeroData,
+          UINT             VertexStreamZeroStride) {
+    uint64_t bytes = uint64_t(GetVertexCount(PrimitiveType, PrimitiveCount)) * VertexStreamZeroStride;
+    if (unlikely(pVertexStreamZeroData == nullptr || bytes > MaxRecord)) {
+      auto direct = Direct();
+      return m_device->DrawPrimitiveUP(PrimitiveType, PrimitiveCount, pVertexStreamZeroData, VertexStreamZeroStride);
+    }
+    if (VertexStreamZeroStride != 0 && PrimitiveCount != 0) {
+      Refresh();
+      m_shadow.streams[0] = D3D9FrontEndStream{ };
+    }
+    auto args = reinterpret_cast<DrawUpArgs*>(Allocate(D3D9FrontEndOp::DrawUp, sizeof(DrawUpArgs) + uint32_t(bytes)));
+    args->type = PrimitiveType;
+    args->count = PrimitiveCount;
+    args->stride = VertexStreamZeroStride;
+    std::memcpy(args + 1, pVertexStreamZeroData, size_t(bytes));
+    return D3D_OK;
+  }
+
+
+  HRESULT D3D9FrontEnd::DrawIndexedUp(
+          D3DPRIMITIVETYPE PrimitiveType,
+          UINT             MinVertexIndex,
+          UINT             NumVertices,
+          UINT             PrimitiveCount,
+    const void*            pIndexData,
+          D3DFORMAT        IndexDataFormat,
+    const void*            pVertexStreamZeroData,
+          UINT             VertexStreamZeroStride) {
+    uint64_t indexBytes = uint64_t(GetVertexCount(PrimitiveType, PrimitiveCount))
+      * (IndexDataFormat == D3DFMT_INDEX16 ? 2u : 4u);
+    uint64_t vertexBytes = uint64_t(MinVertexIndex + NumVertices) * VertexStreamZeroStride;
+    uint64_t indexSpace = Align(uint32_t(std::min<uint64_t>(indexBytes, MaxRecord)));
+    if (unlikely(pIndexData == nullptr || pVertexStreamZeroData == nullptr
+              || indexSpace + vertexBytes > MaxRecord)) {
+      auto direct = Direct();
+      return m_device->DrawIndexedPrimitiveUP(PrimitiveType, MinVertexIndex, NumVertices, PrimitiveCount,
+        pIndexData, IndexDataFormat, pVertexStreamZeroData, VertexStreamZeroStride);
+    }
+    if (VertexStreamZeroStride != 0 && PrimitiveCount != 0 && NumVertices != 0) {
+      Refresh();
+      m_shadow.streams[0] = D3D9FrontEndStream{ };
+    }
+    auto args = reinterpret_cast<DrawIndexedUpArgs*>(Allocate(D3D9FrontEndOp::DrawIndexedUp,
+      sizeof(DrawIndexedUpArgs) + uint32_t(indexSpace + vertexBytes)));
+    args->type = PrimitiveType;
+    args->minIndex = MinVertexIndex;
+    args->vertices = NumVertices;
+    args->count = PrimitiveCount;
+    args->format = IndexDataFormat;
+    args->stride = VertexStreamZeroStride;
+    args->indexBytes = uint32_t(indexSpace);
+    uint8_t* data = reinterpret_cast<uint8_t*>(args + 1);
+    std::memcpy(data, pIndexData, size_t(indexBytes));
+    std::memcpy(data + indexSpace, pVertexStreamZeroData, size_t(vertexBytes));
+    return D3D_OK;
+  }
