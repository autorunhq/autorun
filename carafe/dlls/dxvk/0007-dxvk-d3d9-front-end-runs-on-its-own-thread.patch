+
+  HRESULT D3D9FrontEnd::Present(DWORD Flags) {
+    Queue3(D3D9FrontEndOp::Present, Flags, 0, 0);
+    m_presentsQueued++;
+    Publish();
+
+    uint32_t target = m_presentsQueued - 1;
+    if (int32_t(Load(m_presentsDone) - target) < 0) {
+      m_statFrameWaits++;
+      for (uint32_t i = 0; i < SpinCount && int32_t(Load(m_presentsDone) - target) < 0; i++)
+        _mm_pause();
+      if (int32_t(Load(m_presentsDone) - target) < 0) {
+        std::unique_lock<dxvk::mutex> lock(m_mutex);
+        Store(m_producerWaiting, 1u);
+        while (int32_t(Load(m_presentsDone) - target) < 0)
+          m_doneCond.wait(lock);
+        Store(m_producerWaiting, 0u);
+      }
+    }
+
+    if (++m_statFrames >= ReportFrames)
+      Report();
+
+    return HRESULT(m_lastPresent.load());
+  }
