+  HRESULT D3D9FrontEnd::SetConstants(D3D9FrontEndOp Op, UINT StartRegister, const void* pData, UINT Count,
+      UINT ElementSize) {
+    uint32_t bytes = Count * ElementSize;
+    if (unlikely(pData == nullptr || bytes > MaxRecord)) {
+      auto direct = Direct();
+      HRESULT hr = D3DERR_INVALIDCALL;
+      switch (Op) {
+        case D3D9FrontEndOp::VertexConstantsF:
+          hr = m_device->SetVertexShaderConstantF(StartRegister, static_cast<const float*>(pData), Count); break;
+        case D3D9FrontEndOp::VertexConstantsI:
+          hr = m_device->SetVertexShaderConstantI(StartRegister, static_cast<const int*>(pData), Count); break;
+        case D3D9FrontEndOp::VertexConstantsB:
+          hr = m_device->SetVertexShaderConstantB(StartRegister, static_cast<const BOOL*>(pData), Count); break;
+        case D3D9FrontEndOp::PixelConstantsF:
+          hr = m_device->SetPixelShaderConstantF(StartRegister, static_cast<const float*>(pData), Count); break;
+        case D3D9FrontEndOp::PixelConstantsI:
+          hr = m_device->SetPixelShaderConstantI(StartRegister, static_cast<const int*>(pData), Count); break;
+        case D3D9FrontEndOp::PixelConstantsB:
+          hr = m_device->SetPixelShaderConstantB(StartRegister, static_cast<const BOOL*>(pData), Count); break;
+        default: break;
+      }
+      return hr;
+    }
+    auto args = reinterpret_cast<ConstantArgs*>(Allocate(Op, sizeof(ConstantArgs) + bytes));
+    args->start = StartRegister;
+    args->count = Count;
+    std::memcpy(args + 1, pData, bytes);
+    return D3D_OK;
+  }
