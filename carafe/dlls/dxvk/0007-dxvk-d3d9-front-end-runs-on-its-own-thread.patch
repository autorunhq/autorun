+
+  D3D9FrontEndShadow& D3D9FrontEnd::Mirror(D3D9StateBlock* pStateBlock) {
+    if (pStateBlock->m_frontEndMirror == nullptr) {
+      auto mirror = std::make_unique<D3D9FrontEndShadow>(m_shadow);
+      auto& state = pStateBlock->m_state;
+      const D3D9CapturedStateFlags& flags = pStateBlock->m_captures.flags;
+      if (flags.test(D3D9CapturedStateFlag::RenderStates))
+        mirror->renderStates = state.renderStates.get();
+      if (flags.test(D3D9CapturedStateFlag::SamplerStates))
+        mirror->samplerStates = state.samplerStates.get();
+      if (flags.test(D3D9CapturedStateFlag::TextureStages))
+        mirror->textureStages = state.textureStages.get();
+      if (flags.test(D3D9CapturedStateFlag::Textures))
+        mirror->textures = state.textures.get();
+      if (flags.test(D3D9CapturedStateFlag::VertexBuffers)) {
+        for (uint32_t i = 0; i < caps::MaxStreams; i++) {
+          const auto& vbo = state.vertexBuffers[i];
+          mirror->streams[i] = D3D9FrontEndStream{ vbo.vertexBuffer.ptr(), vbo.offset, vbo.stride };
+        }
+      }
+      if (flags.test(D3D9CapturedStateFlag::VertexDecl)) {
+        mirror->vertexDecl = state.vertexDecl.ptr();
+        mirror->vertexDeclKnown = true;
+      }
+      pStateBlock->m_frontEndMirror = std::move(mirror);
+    }
+    return *pStateBlock->m_frontEndMirror;
+  }
+
+
+  HRESULT D3D9FrontEnd::StateBlockApply(D3D9StateBlock* pStateBlock) {
+    if (unlikely(Recording()))
+      return D3DERR_INVALIDCALL;
+    Refresh();
+
+    const D3D9FrontEndShadow& mirror = Mirror(pStateBlock);
+    D3D9StateCaptures& captures = pStateBlock->m_captures;
+
+    if (captures.flags.test(D3D9CapturedStateFlag::VertexDecl)
+     && (!mirror.vertexDeclKnown || mirror.vertexDecl != nullptr)) {
+      m_shadow.vertexDecl = mirror.vertexDecl;
+      m_shadow.vertexDeclKnown = mirror.vertexDeclKnown;
+    }
+
+    if (captures.flags.test(D3D9CapturedStateFlag::VertexBuffers)) {
+      for (uint32_t idx : bit::BitMask(captures.vertexBuffers.dword(0))) {
+        const D3D9FrontEndStream& stream = mirror.streams[idx];
+        ShadowStream(m_shadow.streams[idx], stream.buffer, stream.offset, stream.stride);
+      }
+    }
+
+    if (captures.flags.test(D3D9CapturedStateFlag::RenderStates)) {
+      for (uint32_t i = 0; i < captures.renderStates.dwordCount(); i++) {
+        for (uint32_t rs : bit::BitMask(captures.renderStates.dword(i))) {
+          uint32_t idx = i * 32 + rs;
+          m_shadow.renderStates[idx] = mirror.renderStates[idx];
+        }
+      }
+    }
+
+    if (captures.flags.test(D3D9CapturedStateFlag::SamplerStates)) {
+      for (uint32_t samplerIdx : bit::BitMask(captures.samplers.dword(0))) {
+        for (uint32_t stateIdx : bit::BitMask(captures.samplerStates[samplerIdx].dword(0)))
+          m_shadow.samplerStates[samplerIdx][stateIdx] = mirror.samplerStates[samplerIdx][stateIdx];
+      }
+    }
+
+    if (captures.flags.test(D3D9CapturedStateFlag::Textures)) {
+      for (uint32_t idx : bit::BitMask(captures.textures.dword(0)))
+        m_shadow.textures[idx] = mirror.textures[idx];
+    }
+
+    if (captures.flags.test(D3D9CapturedStateFlag::TextureStages)) {
+      for (uint32_t stageIdx : bit::BitMask(captures.textureStages.dword(0))) {
+        for (uint32_t stateIdx : bit::BitMask(captures.textureStageStates[stageIdx].dword(0)))
+          m_shadow.textureStages[stageIdx][stateIdx] = mirror.textureStages[stageIdx][stateIdx];
+      }
+    }
+
+    pStateBlock->AddRefPrivate();
+    reinterpret_cast<StateBlockArgs*>(Allocate(D3D9FrontEndOp::StateBlockApply, sizeof(StateBlockArgs)))->block =
+      pStateBlock;
+    return D3D_OK;
+  }
+
+
+  HRESULT D3D9FrontEnd::StateBlockCapture(D3D9StateBlock* pStateBlock) {
+    if (unlikely(Recording()))
+      return D3DERR_INVALIDCALL;
+    Refresh();
+
+    D3D9FrontEndShadow& mirror = Mirror(pStateBlock);
+    std::array<UINT, caps::MaxStreams> offsets;
+    for (uint32_t i = 0; i < caps::MaxStreams; i++)
+      offsets[i] = mirror.streams[i].offset;
+    mirror = m_shadow;
+    for (uint32_t i = 0; i < caps::MaxStreams; i++)
+      mirror.streams[i].offset = offsets[i];
+
+    pStateBlock->AddRefPrivate();
+    reinterpret_cast<StateBlockArgs*>(Allocate(D3D9FrontEndOp::StateBlockCapture, sizeof(StateBlockArgs)))->block =
+      pStateBlock;
+    return D3D_OK;
+  }
+
+
+  bool D3D9FrontEnd::StagesLock(D3D9CommonBuffer* pBuffer, UINT OffsetToLock, UINT SizeToLock, DWORD Flags) const {
+    const D3D9_BUFFER_DESC* desc = pBuffer->Desc();
+    if (pBuffer->m_frontEndStaging.locks != 0)
+      return true;
+    if (!(Flags & D3DLOCK_DISCARD) || (Flags & D3DLOCK_READONLY))
+      return false;
+    if (!(desc->Usage & D3DUSAGE_DYNAMIC) || desc->Pool != D3DPOOL_DEFAULT)
+      return false;
+    if (OffsetToLock >= desc->Size)
+      return false;
+    uint32_t size = SizeToLock == 0 ? desc->Size - OffsetToLock : std::min<UINT>(SizeToLock, desc->Size - OffsetToLock);
+    return size <= StagedLockMax;
+  }
+
+
+  HRESULT D3D9FrontEnd::LockStaged(D3D9CommonBuffer* pBuffer, UINT OffsetToLock, UINT SizeToLock, void** ppbData,
+      DWORD Flags) {
+    if (unlikely(ppbData == nullptr))
+      return D3DERR_INVALIDCALL;
+
+    const D3D9_BUFFER_DESC* desc = pBuffer->Desc();
+    D3D9FrontEndStaging& staging = pBuffer->m_frontEndStaging;
+
+    OffsetToLock = std::min<UINT>(OffsetToLock, desc->Size);
+    uint32_t size = SizeToLock == 0 ? desc->Size - OffsetToLock : std::min<UINT>(SizeToLock, desc->Size - OffsetToLock);
+
+    if (staging.memory.size() < desc->Size)
+      staging.memory.resize(desc->Size);
+
+    if (staging.locks == 0) {
+      staging.offset = OffsetToLock;
+      staging.size = size;
+      staging.flags = Flags;
+    } else {
+      uint32_t end = std::max(staging.offset + staging.size, OffsetToLock + size);
+      staging.offset = std::min<uint32_t>(staging.offset, OffsetToLock);
+      staging.size = end - staging.offset;
+    }
+    staging.locks++;
+
+    *ppbData = staging.memory.data() + OffsetToLock;
+    return D3D_OK;
+  }
+
+
+  HRESULT D3D9FrontEnd::UnlockStaged(D3D9CommonBuffer* pBuffer) {
+    D3D9FrontEndStaging& staging = pBuffer->m_frontEndStaging;
+    if (staging.locks == 0)
+      return D3D_OK;
+    if (--staging.locks != 0)
+      return D3D_OK;
+
+    m_statStaged++;
+    staging.addRef(staging.owner);
+    auto args = reinterpret_cast<UploadArgs*>(Allocate(D3D9FrontEndOp::BufferUpload,
+      sizeof(UploadArgs) + staging.size));
+    args->buffer = pBuffer;
+    args->owner = staging.owner;
+    args->release = staging.release;
+    args->offset = staging.offset;
+    args->size = staging.size;
+    args->flags = staging.flags;
+    std::memcpy(args + 1, staging.memory.data() + staging.offset, staging.size);
+    return D3D_OK;
+  }
+
+
+  void D3D9FrontEnd::Report() {
+    double frames = double(m_statFrames);
+    Logger::info(str::format("[D3D9 front end] per frame over ", m_statFrames, " frames: calls queued ",
+      uint64_t(double(m_statQueued) / frames), ", unchanged states dropped ", uint64_t(double(m_statDropped) / frames),
+      ", buffer locks staged ", uint64_t(double(m_statStaged) / frames), "; in all: drains ", m_statDrains, " (",
+      m_statDrainUs, " us), waits for ring room ", m_statRoomWaits, ", frames waited for the worker ",
+      m_statFrameWaits));
+    std::sort(m_drainSites.begin(), m_drainSites.end(),
+      [] (const auto& a, const auto& b) { return a.second > b.second; });
+    std::string sites;
+    for (const auto& site : m_drainSites) {
+      if (site.second != 0)
+        sites += str::format(" d3d9.dll+0x", std::hex, site.first, std::dec, " ", site.second);
+    }
+    if (!sites.empty())
+      Logger::info(str::format("[D3D9 front end] drains by caller:", sites));
+    m_drainSites = { };
+    m_statQueued = 0;
+    m_statDropped = 0;
+    m_statStaged = 0;
+    m_statDrains = 0;
+    m_statDrainUs = 0;
+    m_statRoomWaits = 0;
+    m_statFrameWaits = 0;
+    m_statFrames = 0;
+  }
+
+
+  void D3D9FrontEnd::Run() {
+    env::setThreadName("dxvk-frontend");
+
+    uint32_t read = 0;
+    uint32_t sinceComplete = 0;
+
+    auto complete = [&] {
+      sinceComplete = 0;
+      Store(m_completed, read);
+      if (Load(m_producerWaiting)) {
+        std::lock_guard<dxvk::mutex> lock(m_mutex);
+        m_doneCond.notify_all();
+      }
+    };
+
+    for (;;) {
+      uint32_t end = Load(m_published);
+
+      if (end == read) {
+        if (sinceComplete != 0)
+          complete();
+
+        for (uint32_t i = 0; i < SpinCount && end == read; i++) {
+          _mm_pause();
+          end = Load(m_published);
+        }
+
+        if (end == read) {
+          std::unique_lock<dxvk::mutex> lock(m_mutex);
+          Store(m_workerSleeping, 1u);
+          while ((end = Load(m_published)) == read)
+            m_workCond.wait(lock);
+          Store(m_workerSleeping, 0u);
+        }
+      }
+
+      while (read != end) {
+        const uint8_t* record = m_ring + (read & (RingSize - 1));
+        const Header* header = reinterpret_cast<const Header*>(record);
+        uint32_t size = header->size;
+
+        if (unlikely(header->op == D3D9FrontEndOp::Stop)) {
+          read += size;
+          complete();
+          return;
+        }
+
+        Execute(record);
+        read += size;
+
+        if (++sinceComplete >= PublishEvery)
+          complete();
+      }
+
+      complete();
+    }
+  }
+
+
+  uint32_t D3D9FrontEnd::Execute(const uint8_t* pRecord) {
+    const Header* header = reinterpret_cast<const Header*>(pRecord);
+    const void* body = pRecord + sizeof(Header);
+    D3D9DeviceEx* device = m_device;
+
+    switch (header->op) {
+      case D3D9FrontEndOp::Wrap:
+        break;
+
+      case D3D9FrontEndOp::RenderState: {
+        auto args = static_cast<const Args3*>(body);
+        device->SetStateRenderState(D3DRENDERSTATETYPE(args->a), args->b);
+      } break;
+
+      case D3D9FrontEndOp::SamplerState: {
+        auto args = static_cast<const Args3*>(body);
+        device->SetStateSamplerState(args->a, D3DSAMPLERSTATETYPE(args->b), args->c);
+      } break;
+
+      case D3D9FrontEndOp::TextureStageState: {
+        auto args = static_cast<const Args3*>(body);
+        device->SetStateTextureStageState(args->a, D3D9TextureStageStateTypes(args->b), args->c);
+      } break;
+
+      case D3D9FrontEndOp::Texture: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto texture = static_cast<IDirect3DBaseTexture9*>(args->object);
+        device->SetStateTexture(args->a, texture);
+        TextureRefPrivate(texture, false);
+      } break;
+
+      case D3D9FrontEndOp::StreamSource: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto buffer = static_cast<D3D9VertexBuffer*>(args->object);
+        device->SetStreamSource(args->a, buffer, args->b, args->c);
+        RefPrivate<D3D9VertexBuffer>(buffer, false);
+      } break;
+
+      case D3D9FrontEndOp::StreamSourceFreq: {
+        auto args = static_cast<const Args3*>(body);
+        device->SetStreamSourceFreq(args->a, args->b);
+      } break;
+
+      case D3D9FrontEndOp::Indices: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto buffer = static_cast<D3D9IndexBuffer*>(args->object);
+        device->SetIndices(buffer);
+        RefPrivate<D3D9IndexBuffer>(buffer, false);
+      } break;
+
+      case D3D9FrontEndOp::RenderTarget: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto surface = static_cast<D3D9Surface*>(args->object);
+        device->SetRenderTarget(args->a, surface);
+        RefPrivate<D3D9Surface>(surface, false);
+      } break;
+
+      case D3D9FrontEndOp::DepthStencil: {
+        auto surface = static_cast<D3D9Surface*>(static_cast<const ObjectArgs*>(body)->object);
+        device->SetDepthStencilSurface(surface);
+        RefPrivate<D3D9Surface>(surface, false);
+      } break;
+
+      case D3D9FrontEndOp::StretchRect: {
+        auto args = static_cast<const StretchArgs*>(body);
+        device->StretchRect(args->src, args->hasSrcRect ? &args->srcRect : nullptr, args->dst,
+          args->hasDstRect ? &args->dstRect : nullptr, args->filter);
+        RefPrivate<D3D9Surface>(args->src, false);
+        RefPrivate<D3D9Surface>(args->dst, false);
+      } break;
+
+      case D3D9FrontEndOp::VertexShader: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto shader = static_cast<D3D9VertexShader*>(args->object);
+        device->SetVertexShader(shader);
+        RefPrivate<D3D9VertexShader>(shader, false);
+      } break;
+
+      case D3D9FrontEndOp::PixelShader: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto shader = static_cast<D3D9PixelShader*>(args->object);
+        device->SetPixelShader(shader);
+        RefPrivate<D3D9PixelShader>(shader, false);
+      } break;
+
+      case D3D9FrontEndOp::VertexDeclaration: {
+        auto args = static_cast<const ObjectArgs*>(body);
+        auto decl = static_cast<D3D9VertexDecl*>(args->object);
+        device->SetVertexDeclaration(decl);
+        RefPrivate<D3D9VertexDecl>(decl, false);
+      } break;
+
+      case D3D9FrontEndOp::Fvf:
+        device->SetFVF(static_cast<const Args3*>(body)->a);
+        break;
+
+      case D3D9FrontEndOp::VertexConstantsF:
+      case D3D9FrontEndOp::VertexConstantsI:
+      case D3D9FrontEndOp::VertexConstantsB:
+      case D3D9FrontEndOp::PixelConstantsF:
+      case D3D9FrontEndOp::PixelConstantsI:
+      case D3D9FrontEndOp::PixelConstantsB: {
+        auto args = static_cast<const ConstantArgs*>(body);
+        const void* data = args + 1;
+        switch (header->op) {
+          case D3D9FrontEndOp::VertexConstantsF:
+            device->SetVertexShaderConstantF(args->start, static_cast<const float*>(data), args->count); break;
+          case D3D9FrontEndOp::VertexConstantsI:
+            device->SetVertexShaderConstantI(args->start, static_cast<const int*>(data), args->count); break;
+          case D3D9FrontEndOp::VertexConstantsB:
+            device->SetVertexShaderConstantB(args->start, static_cast<const BOOL*>(data), args->count); break;
+          case D3D9FrontEndOp::PixelConstantsF:
+            device->SetPixelShaderConstantF(args->start, static_cast<const float*>(data), args->count); break;
+          case D3D9FrontEndOp::PixelConstantsI:
+            device->SetPixelShaderConstantI(args->start, static_cast<const int*>(data), args->count); break;
+          default:
+            device->SetPixelShaderConstantB(args->start, static_cast<const BOOL*>(data), args->count); break;
+        }
+      } break;
+
+      case D3D9FrontEndOp::Transform: {
+        auto args = static_cast<const TransformArgs*>(body);
+        device->SetTransform(D3DTRANSFORMSTATETYPE(args->state), &args->matrix);
+      } break;
+
+      case D3D9FrontEndOp::MultiplyTransform: {
+        auto args = static_cast<const TransformArgs*>(body);
+        device->MultiplyTransform(D3DTRANSFORMSTATETYPE(args->state), &args->matrix);
+      } break;
+
+      case D3D9FrontEndOp::Viewport:
+        device->SetViewport(static_cast<const D3DVIEWPORT9*>(body));
+        break;
+
+      case D3D9FrontEndOp::ScissorRect:
+        device->SetScissorRect(static_cast<const RECT*>(body));
+        break;
+
+      case D3D9FrontEndOp::Material:
+        device->SetMaterial(static_cast<const D3DMATERIAL9*>(body));
+        break;
+
+      case D3D9FrontEndOp::Light: {
+        auto args = static_cast<const LightArgs*>(body);
+        device->SetLight(args->index, &args->light);
+      } break;
+
+      case D3D9FrontEndOp::LightEnable: {
+        auto args = static_cast<const Args3*>(body);
+        device->LightEnable(args->a, BOOL(args->b));
+      } break;
+
+      case D3D9FrontEndOp::ClipPlane: {
+        auto args = static_cast<const ClipPlaneArgs*>(body);
+        device->SetClipPlane(args->index, args->plane);
+      } break;
+
+      case D3D9FrontEndOp::Clear: {
+        auto args = static_cast<const ClearArgs*>(body);
+        auto rects = args->rects != 0 ? reinterpret_cast<const D3DRECT*>(args + 1) : nullptr;
+        device->Clear(args->count, rects, args->flags, args->color, args->z, args->stencil);
+      } break;
+
+      case D3D9FrontEndOp::Draw: {
+        auto args = static_cast<const DrawArgs*>(body);
+        device->DrawPrimitive(args->type, args->start, args->count);
+      } break;
+
+      case D3D9FrontEndOp::DrawIndexed: {
+        auto args = static_cast<const DrawIndexedArgs*>(body);
+        device->DrawIndexedPrimitive(args->type, args->base, args->minIndex, args->vertices, args->start,
+          args->count);
+      } break;
+
+      case D3D9FrontEndOp::DrawUp: {
+        auto args = static_cast<const DrawUpArgs*>(body);
+        device->DrawPrimitiveUP(args->type, args->count, args + 1, args->stride);
+      } break;
+
+      case D3D9FrontEndOp::DrawIndexedUp: {
+        auto args = static_cast<const DrawIndexedUpArgs*>(body);
+        auto data = reinterpret_cast<const uint8_t*>(args + 1);
+        device->DrawIndexedPrimitiveUP(args->type, args->minIndex, args->vertices, args->count, data, args->format,
+          data + args->indexBytes, args->stride);
+      } break;
+
+      case D3D9FrontEndOp::BeginScene:
+        device->BeginScene();
+        break;
+
+      case D3D9FrontEndOp::EndScene:
+        device->EndScene();
+        break;
+
+      case D3D9FrontEndOp::Present: {
+        auto args = static_cast<const Args3*>(body);
+        m_lastPresent.store(int32_t(device->PresentEx(nullptr, nullptr, nullptr, nullptr, args->a)));
+        m_presentsDone.fetch_add(1u);
+        if (Load(m_producerWaiting)) {
+          std::lock_guard<dxvk::mutex> lock(m_mutex);
+          m_doneCond.notify_all();
+        }
+      } break;
+
+      case D3D9FrontEndOp::StateBlockApply: {
+        auto block = static_cast<const StateBlockArgs*>(body)->block;
+        block->Apply();
+        block->ReleasePrivate();
+      } break;
+
+      case D3D9FrontEndOp::StateBlockCapture: {
+        auto block = static_cast<const StateBlockArgs*>(body)->block;
+        block->Capture();
+        block->ReleasePrivate();
+      } break;
+
+      case D3D9FrontEndOp::BufferUpload: {
+        auto args = static_cast<const UploadArgs*>(body);
+        void* data = nullptr;
+        if (SUCCEEDED(args->buffer->Lock(args->offset, args->size, &data, args->flags)) && data != nullptr) {
+          std::memcpy(data, args + 1, args->size);
+          args->buffer->Unlock();
+        }
+        args->release(args->owner);
+      } break;
+
+      case D3D9FrontEndOp::Stop:
+        break;
+    }
+
+    return header->size;
+  }
+
+}
diff -ruN a/src/d3d9/d3d9_front_end.h b/src/d3d9/d3d9_front_end.h
--- a/src/d3d9/d3d9_front_end.h
+++ b/src/d3d9/d3d9_front_end.h
@@ -0,0 +1,393 @@
+#pragma once
+
+#include <atomic>
+#include <cstring>
+
+#include "d3d9_include.h"
+#include "d3d9_state.h"
+#include "d3d9_util.h"
+
+#include "../util/thread.h"
+
+#if defined(__i386__) || defined(__x86_64__)
+#include <intrin.h>
+#endif
+
+namespace dxvk {
+
+  class D3D9DeviceEx;
+  class D3D9StateBlock;
+  class D3D9CommonBuffer;
+  class D3D9Surface;
+
+  enum class D3D9FrontEndOp : uint32_t {
+    Wrap,
+    RenderState,
+    SamplerState,
+    TextureStageState,
+    Texture,
+    StreamSource,
+    StreamSourceFreq,
+    Indices,
+    RenderTarget,
+    DepthStencil,
+    StretchRect,
+    VertexShader,
+    PixelShader,
+    VertexDeclaration,
+    Fvf,
+    VertexConstantsF,
+    VertexConstantsI,
+    VertexConstantsB,
+    PixelConstantsF,
+    PixelConstantsI,
+    PixelConstantsB,
+    Transform,
+    MultiplyTransform,
+    Viewport,
+    ScissorRect,
+    Material,
+    Light,
+    LightEnable,
+    ClipPlane,
+    Clear,
+    Draw,
+    DrawIndexed,
+    DrawUp,
+    DrawIndexedUp,
+    BeginScene,
+    EndScene,
+    Present,
+    StateBlockApply,
+    StateBlockCapture,
+    BufferUpload,
+    Stop,
+  };
+
+  class D3D9VertexBuffer;
+  class D3D9VertexDecl;
+
+  struct D3D9FrontEndStream {
+    D3D9VertexBuffer* buffer;
+    UINT              offset;
+    UINT              stride;
+  };
+
+  struct D3D9FrontEndShadow {
+    std::array<DWORD, RenderStateCount>                                             renderStates;
+    std::array<std::array<DWORD, SamplerStateCount>, SamplerCount>                  samplerStates;
+    std::array<std::array<DWORD, TextureStageStateCount>, caps::TextureStageCount> textureStages;
+    std::array<IDirect3DBaseTexture9*, SamplerCount>                                textures;
+    std::array<D3D9Surface*, caps::MaxSimultaneousRenderTargets>                    renderTargets;
+    D3D9Surface*                                                                    depthStencil;
+    std::array<D3D9FrontEndStream, caps::MaxStreams>                                streams;
+    D3D9VertexDecl*                                                                 vertexDecl;
+    bool                                                                            vertexDeclKnown;
+  };
+
+  class D3D9FrontEnd {
+
+  public:
+
+    static constexpr uint32_t RingSize      = 1u << 20;
+    static constexpr uint32_t MaxRecord     = RingSize / 8;
+    static constexpr uint32_t PublishEvery  = 32;
+    static constexpr uint32_t SpinCount     = 4000;
+    static constexpr uint32_t ReportFrames  = 600;
+    static constexpr uint32_t StagedLockMax = 64u << 10;
+
+    explicit D3D9FrontEnd(D3D9DeviceEx* pDevice);
+
+    ~D3D9FrontEnd();
+
+    void Start();
+
+    void Stop();
+
+    bool Queues() const {
+      return m_producer != 0 && m_producer == CurrentThread();
+    }
+
+    bool Active() const {
+      return m_producer != 0;
+    }
+
+    const D3D9FrontEndShadow& Shadow() {
+      Refresh();
+      return m_shadow;
+    }
+
+    class DirectScope {
+
+    public:
+
+      DirectScope(D3D9FrontEnd* pFrontEnd, uint32_t Producer)
+      : m_frontEnd(pFrontEnd), m_producer(Producer) { }
+
+      DirectScope(const DirectScope&) = delete;
+      DirectScope& operator = (const DirectScope&) = delete;
+
+      ~DirectScope() {
+        if (m_producer != 0)
+          m_frontEnd->m_producer = m_producer;
+      }
+
+    private:
+
+      D3D9FrontEnd* m_frontEnd;
+      uint32_t      m_producer;
+
+    };
+
+    DirectScope Direct() {
+      if (!Queues())
+        return DirectScope(this, 0u);
+      DrainProducer();
+      m_stale = true;
+      return DirectScope(this, std::exchange(m_producer, 0u));
+    }
+
+    void Gate() {
+      if (unlikely(m_producer != 0) && CurrentThread() != m_worker)
+        GateSlow();
+    }
+
+    HRESULT SetRenderState(D3DRENDERSTATETYPE State, DWORD Value) {
+      if (likely(uint32_t(State) < RenderStateCount) && likely(!Recording())) {
+        Refresh();
+        if (m_shadow.renderStates[State] == Value)
+          return Dropped();
+        m_shadow.renderStates[State] = Value;
+      }
+      return Queue3(D3D9FrontEndOp::RenderState, uint32_t(State), Value, 0);
+    }
+
+    HRESULT SetSamplerState(DWORD StateSampler, D3DSAMPLERSTATETYPE Type, DWORD Value) {
+      if (likely(uint32_t(Type) < SamplerStateCount) && likely(!Recording())) {
+        Refresh();
+        if (m_shadow.samplerStates[StateSampler][Type] == Value)
+          return Dropped();
+        m_shadow.samplerStates[StateSampler][Type] = Value;
+      }
+      return Queue3(D3D9FrontEndOp::SamplerState, StateSampler, uint32_t(Type), Value);
+    }
+
+    HRESULT SetTextureStageState(DWORD Stage, D3D9TextureStageStateTypes Type, DWORD Value) {
+      if (likely(Stage < caps::TextureStageCount && uint32_t(Type) < TextureStageStateCount) && likely(!Recording())) {
+        Refresh();
+        if (m_shadow.textureStages[Stage][Type] == Value)
+          return Dropped();
+        m_shadow.textureStages[Stage][Type] = Value;
+      }
+      return Queue3(D3D9FrontEndOp::TextureStageState, Stage, uint32_t(Type), Value);
+    }
+
+    HRESULT SetTexture(DWORD StateSampler, IDirect3DBaseTexture9* pTexture);
+
+    HRESULT SetStreamSource(UINT StreamNumber, IDirect3DVertexBuffer9* pStreamData, UINT OffsetInBytes, UINT Stride);
+
+    HRESULT GetStreamSource(UINT StreamNumber, IDirect3DVertexBuffer9** ppStreamData, UINT* pOffsetInBytes,
+      UINT* pStride);
+
+    HRESULT SetStreamSourceFreq(UINT StreamNumber, UINT Setting);
+
+    HRESULT SetIndices(IDirect3DIndexBuffer9* pIndexData);
+
+    HRESULT SetRenderTarget(DWORD RenderTargetIndex, IDirect3DSurface9* pRenderTarget);
+
+    HRESULT GetRenderTarget(DWORD RenderTargetIndex, IDirect3DSurface9** ppRenderTarget);
+
+    HRESULT TestCooperativeLevel();
+
+    HRESULT SetDepthStencilSurface(IDirect3DSurface9* pNewZStencil);
+
+    HRESULT GetDepthStencilSurface(IDirect3DSurface9** ppZStencilSurface);
+
+    HRESULT StretchRect(
+            IDirect3DSurface9*   pSourceSurface,
+      const RECT*                pSourceRect,
+            IDirect3DSurface9*   pDestSurface,
+      const RECT*                pDestRect,
+            D3DTEXTUREFILTERTYPE Filter);
+
+    HRESULT SetVertexShader(IDirect3DVertexShader9* pShader);
+
+    HRESULT SetPixelShader(IDirect3DPixelShader9* pShader);
+
+    HRESULT SetVertexDeclaration(IDirect3DVertexDeclaration9* pDecl);
+
+    HRESULT GetVertexDeclaration(IDirect3DVertexDeclaration9** ppDecl);
+
+    D3D9VertexDecl* VertexDecl();
+
+    HRESULT SetFVF(DWORD FVF);
+
+    HRESULT SetConstants(D3D9FrontEndOp Op, UINT StartRegister, const void* pData, UINT Count, UINT ElementSize);
+
+    HRESULT SetTransform(D3D9FrontEndOp Op, D3DTRANSFORMSTATETYPE State, const D3DMATRIX* pMatrix);
+
+    HRESULT SetViewport(const D3DVIEWPORT9* pViewport);
+
+    HRESULT SetScissorRect(const RECT* pRect);
+
+    HRESULT SetMaterial(const D3DMATERIAL9* pMaterial);
+
+    HRESULT SetLight(DWORD Index, const D3DLIGHT9* pLight);
+
+    HRESULT LightEnable(DWORD Index, BOOL Enable);
+
+    HRESULT SetClipPlane(DWORD Index, const float* pPlane);
+
+    HRESULT Clear(DWORD Count, const D3DRECT* pRects, DWORD Flags, D3DCOLOR Color, float Z, DWORD Stencil);
+
+    HRESULT Draw(D3DPRIMITIVETYPE PrimitiveType, UINT StartVertex, UINT PrimitiveCount);
+
+    HRESULT DrawIndexed(
+            D3DPRIMITIVETYPE PrimitiveType,
+            INT              BaseVertexIndex,
+            UINT             MinVertexIndex,
+            UINT             NumVertices,
+            UINT             StartIndex,
+            UINT             PrimitiveCount);
+
+    HRESULT DrawUp(
+            D3DPRIMITIVETYPE PrimitiveType,
+            UINT             PrimitiveCount,
+      const void*            pVertexStreamZeroData,
+            UINT             VertexStreamZeroStride);
+
+    HRESULT DrawIndexedUp(
+            D3DPRIMITIVETYPE PrimitiveType,
+            UINT             MinVertexIndex,
+            UINT             NumVertices,
+            UINT             PrimitiveCount,
+      const void*            pIndexData,
+            D3DFORMAT        IndexDataFormat,
+      const void*            pVertexStreamZeroData,
+            UINT             VertexStreamZeroStride);
+
+    HRESULT Scene(D3D9FrontEndOp Op);
+
+    bool QueuesPresent(const RECT* pSourceRect, const RECT* pDestRect, HWND hDestWindowOverride,
+      const RGNDATA* pDirtyRegion) const;
+
+    HRESULT Present(DWORD Flags);
+
+    HRESULT StateBlockApply(D3D9StateBlock* pStateBlock);
+
+    HRESULT StateBlockCapture(D3D9StateBlock* pStateBlock);
+
+    bool StagesLock(D3D9CommonBuffer* pBuffer, UINT OffsetToLock, UINT SizeToLock, DWORD Flags) const;
+
+    HRESULT LockStaged(D3D9CommonBuffer* pBuffer, UINT OffsetToLock, UINT SizeToLock, void** ppbData, DWORD Flags);
+
+    HRESULT UnlockStaged(D3D9CommonBuffer* pBuffer);
+
+  private:
+
+    struct Header {
+      D3D9FrontEndOp op;
+      uint32_t       size;
+    };
+
+    D3D9DeviceEx*         m_device;
+    uint32_t              m_producer = 0;
+    uint32_t              m_worker   = 0;
+    dxvk::thread          m_thread;
+
+    uint8_t*              m_ring     = nullptr;
+    uint32_t              m_write    = 0;
+    uint32_t              m_space    = 0;
+    uint32_t              m_unpublished = 0;
+    bool                  m_pending  = false;
+    bool                  m_stale    = true;
+
+    D3D9FrontEndShadow    m_shadow   = { };
+
+    uint32_t              m_presentsQueued = 0;
+    HRESULT               m_presentResult  = D3D_OK;
+
+    alignas(64) std::atomic<uint32_t> m_published { 0u };
+    std::atomic<uint32_t> m_workerSleeping   { 0u };
+    alignas(64) std::atomic<uint32_t> m_completed { 0u };
+    std::atomic<uint32_t> m_presentsDone     { 0u };
+    std::atomic<uint32_t> m_producerWaiting  { 0u };
+    std::atomic<int32_t>  m_lastPresent      { 0 };
+
+    dxvk::mutex              m_mutex;
+    dxvk::condition_variable m_workCond;
+    dxvk::condition_variable m_doneCond;
+
+    uint64_t m_statQueued    = 0;
+    uint64_t m_statDropped   = 0;
+    uint64_t m_statDrains    = 0;
+    uint64_t m_statDrainUs   = 0;
+    uint64_t m_statRoomWaits = 0;
+    uint64_t m_statFrameWaits = 0;
+    uint64_t m_statStaged    = 0;
+    uint32_t m_statFrames    = 0;
+
+    std::array<std::pair<uintptr_t, uint32_t>, 8> m_drainSites = { };
+
+    static uint32_t CurrentThread() {
+#if defined(__i386__)
+      return __readfsdword(0x24);
+#elif defined(__x86_64__)
+      return __readgsdword(0x48);
+#else
+      return GetCurrentThreadId();
+#endif
+    }
+
+    static uint32_t Load(std::atomic<uint32_t>& value) {
+      return value.fetch_add(0u);
+    }
+
+    static void Store(std::atomic<uint32_t>& value, uint32_t v) {
+      value.exchange(v);
+    }
+
+    bool Recording() const;
+
+    HRESULT Dropped() {
+      m_statDropped++;
+      return D3D_OK;
+    }
+
+    void Refresh() {
+      if (unlikely(m_stale))
+        Resync();
+    }
+
+    static void ShadowStream(D3D9FrontEndStream& Stream, D3D9VertexBuffer* pBuffer, UINT Offset, UINT Stride) {
+      if (Stream.buffer != pBuffer)
+        Stream = pBuffer != nullptr ? D3D9FrontEndStream{ pBuffer, Offset, Stride } : D3D9FrontEndStream{ };
+      else if (pBuffer != nullptr)
+        Stream = D3D9FrontEndStream{ pBuffer, Offset, Stride };
+    }
+
+    HRESULT Queue3(D3D9FrontEndOp Op, uint32_t A, uint32_t B, uint32_t C);
+
+    uint8_t* Allocate(D3D9FrontEndOp Op, uint32_t Bytes);
+
+    void Publish();
+
+    void WaitCompleted(uint32_t Target);
+
+    void DrainProducer();
+
+    void GateSlow();
+
+    void Resync();
+
+    D3D9FrontEndShadow& Mirror(D3D9StateBlock* pStateBlock);
+
+    void Report();
+
+    void Run();
+
+    uint32_t Execute(const uint8_t* pRecord);
+
+  };
+
+}
