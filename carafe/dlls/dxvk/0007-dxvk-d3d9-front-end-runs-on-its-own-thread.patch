+  void D3D9FrontEnd::Start() {
+    m_ring = static_cast<uint8_t*>(std::malloc(RingSize));
+    if (m_ring == nullptr)
+      return;
+    m_space = RingSize;
+    m_thread = dxvk::thread([this] { Run(); });
+    if (!m_thread.joinable()) {
+      std::free(m_ring);
+      m_ring = nullptr;
+      return;
+    }
+    m_worker = m_thread.get_id();
+    m_producer = CurrentThread();
+    m_stale = true;
+    Logger::info("D3D9: the front end runs on its own thread");
+  }
+
+
+  void D3D9FrontEnd::Stop() {
+    if (m_producer == 0)
+      return;
+    if (m_producer != CurrentThread()) {
+      Store(m_published, m_write);
+      WaitCompleted(m_write);
+    }
+    Allocate(D3D9FrontEndOp::Stop, 0);
+    Publish();
+    m_thread.join();
+    m_producer = 0;
+    m_worker = 0;
+    std::free(m_ring);
+    m_ring = nullptr;
+  }
+
+
+  bool D3D9FrontEnd::Recording() const {
+    return m_device->ShouldRecord();
+  }
+
+
+  uint8_t* D3D9FrontEnd::Allocate(D3D9FrontEndOp Op, uint32_t Bytes) {
+    if (m_unpublished >= PublishEvery)
+      Publish();
+
+    uint32_t size = Align(sizeof(Header) + Bytes);
+    uint32_t offset = m_write & (RingSize - 1);
+    uint32_t toEnd = RingSize - offset;
+    uint32_t need = toEnd < size ? size + toEnd : size;
+
+    if (unlikely(need > m_space)) {
+      uint32_t used = m_write - Load(m_completed);
+      m_space = RingSize - used;
+      if (need > m_space) {
+        m_statRoomWaits++;
+        WaitCompleted(m_write - (RingSize - need));
+        m_space = RingSize - (m_write - Load(m_completed));
+      }
+    }
+
+    if (toEnd < size) {
+      Header* wrap = reinterpret_cast<Header*>(m_ring + offset);
+      wrap->op = D3D9FrontEndOp::Wrap;
+      wrap->size = toEnd;
+      m_write += toEnd;
+      m_space -= toEnd;
+      offset = 0;
+    }
+
+    Header* header = reinterpret_cast<Header*>(m_ring + offset);
+    header->op = Op;
+    header->size = size;
+    m_write += size;
+    m_space -= size;
+    m_pending = true;
+    m_statQueued++;
+    m_unpublished++;
+
+    return m_ring + offset + sizeof(Header);
+  }
+
+
+  void D3D9FrontEnd::Publish() {
+    m_unpublished = 0;
+    Store(m_published, m_write);
+    if (Load(m_workerSleeping)) {
+      std::lock_guard<dxvk::mutex> lock(m_mutex);
+      m_workCond.notify_one();
+    }
+  }
+
+
+  void D3D9FrontEnd::WaitCompleted(uint32_t Target) {
+    Publish();
+    for (uint32_t i = 0; i < SpinCount; i++) {
+      if (int32_t(Load(m_completed) - Target) >= 0)
+        return;
+      _mm_pause();
+    }
+    std::unique_lock<dxvk::mutex> lock(m_mutex);
+    Store(m_producerWaiting, 1u);
+    while (int32_t(Load(m_completed) - Target) < 0)
+      m_doneCond.wait(lock);
+    Store(m_producerWaiting, 0u);
+  }
+
+
+  void D3D9FrontEnd::DrainProducer() {
+    if (!m_pending)
+      return;
+    uint64_t start = NowUs();
+    WaitCompleted(m_write);
+    m_pending = false;
+    m_statDrains++;
+    m_statDrainUs += NowUs() - start;
+  }
+
+
+  void D3D9FrontEnd::GateSlow() {
+    if (CurrentThread() == m_producer) {
+      if (m_pending) {
+        uintptr_t site = uintptr_t(__builtin_return_address(0)) - uintptr_t(&__ImageBase);
+        auto entry = std::find_if(m_drainSites.begin(), m_drainSites.end(),
+          [site] (const auto& e) { return e.first == site || e.second == 0; });
+        if (entry == m_drainSites.end())
+          entry = std::min_element(m_drainSites.begin(), m_drainSites.end(),
+            [] (const auto& a, const auto& b) { return a.second < b.second; });
+        if (entry->first != site)
+          *entry = { site, 0u };
+        entry->second++;
+      }
+      DrainProducer();
+    } else {
+      Store(m_published, m_write);
+      WaitCompleted(m_write);
+      m_stale = true;
+    }
+  }
+
+
+  void D3D9FrontEnd::Resync() {
+    DrainProducer();
+    auto& state = m_device->m_state;
+    m_shadow.renderStates = state.renderStates.get();
+    m_shadow.samplerStates = state.samplerStates.get();
+    m_shadow.textureStages = state.textureStages.get();
+    m_shadow.textures = state.textures.get();
+    for (uint32_t i = 0; i < caps::MaxSimultaneousRenderTargets; i++)
+      m_shadow.renderTargets[i] = state.renderTargets[i].ptr();
+    m_shadow.depthStencil = state.depthStencil.ptr();
+    for (uint32_t i = 0; i < caps::MaxStreams; i++) {
+      const auto& vbo = state.vertexBuffers[i];
+      m_shadow.streams[i] = D3D9FrontEndStream{ vbo.vertexBuffer.ptr(), vbo.offset, vbo.stride };
+    }
+    m_shadow.vertexDecl = state.vertexDecl.ptr();
+    m_shadow.vertexDeclKnown = true;
+    m_stale = false;
+  }
