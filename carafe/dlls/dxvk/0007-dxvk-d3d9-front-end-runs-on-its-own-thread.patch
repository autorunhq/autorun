+  HRESULT D3D9FrontEnd::Queue3(D3D9FrontEndOp Op, uint32_t A, uint32_t B, uint32_t C) {
+    auto args = reinterpret_cast<Args3*>(Allocate(Op, sizeof(Args3)));
+    args->a = A;
+    args->b = B;
+    args->c = C;
+    return D3D_OK;
+  }
