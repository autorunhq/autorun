+
+  HRESULT D3D9FrontEnd::SetStreamSource(UINT StreamNumber, IDirect3DVertexBuffer9* pStreamData, UINT OffsetInBytes,
+      UINT Stride) {
+    if (unlikely(StreamNumber >= caps::MaxStreams))
+      return D3DERR_INVALIDCALL;
+    D3D9VertexBuffer* buffer = static_cast<D3D9VertexBuffer*>(pStreamData);
+    if (likely(!Recording())) {
+      Refresh();
+      ShadowStream(m_shadow.streams[StreamNumber], buffer, OffsetInBytes, Stride);
+    }
+    RefPrivate<D3D9VertexBuffer>(buffer, true);
+    auto args = reinterpret_cast<ObjectArgs*>(Allocate(D3D9FrontEndOp::StreamSource, sizeof(ObjectArgs)));
+    args->object = buffer;
+    args->a = StreamNumber;
+    args->b = OffsetInBytes;
+    args->c = Stride;
+    return D3D_OK;
+  }
+
+
+  HRESULT D3D9FrontEnd::GetStreamSource(UINT StreamNumber, IDirect3DVertexBuffer9** ppStreamData,
+      UINT* pOffsetInBytes, UINT* pStride) {
+    InitReturnPtr(ppStreamData);
+    if (likely(pOffsetInBytes != nullptr))
+      *pOffsetInBytes = 0;
+    if (likely(pStride != nullptr))
+      *pStride = 0;
+    if (unlikely(ppStreamData == nullptr || pOffsetInBytes == nullptr || pStride == nullptr
+              || StreamNumber >= caps::MaxStreams))
+      return D3DERR_INVALIDCALL;
+    Refresh();
+    const D3D9FrontEndStream& stream = m_shadow.streams[StreamNumber];
+    *ppStreamData = stream.buffer != nullptr ? ref(stream.buffer) : nullptr;
+    *pOffsetInBytes = stream.offset;
+    *pStride = stream.stride;
+    return D3D_OK;
+  }
+
+
+  HRESULT D3D9FrontEnd::SetStreamSourceFreq(UINT StreamNumber, UINT Setting) {
+    return Queue3(D3D9FrontEndOp::StreamSourceFreq, StreamNumber, Setting, 0);
