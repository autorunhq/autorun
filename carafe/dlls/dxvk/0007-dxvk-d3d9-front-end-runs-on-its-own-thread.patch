+  HRESULT D3D9FrontEnd::TestCooperativeLevel() {
+    switch (m_device->m_deviceLostState) {
+      case D3D9DeviceLostState::Ok:       return D3D_OK;
+      case D3D9DeviceLostState::NotReset: return D3DERR_DEVICENOTRESET;
+      default:                            return D3DERR_DEVICELOST;
+    }
+  }
