+  HRESULT D3D9FrontEnd::SetTexture(DWORD StateSampler, IDirect3DBaseTexture9* pTexture) {
+    if (likely(!Recording())) {
+      Refresh();
+      if (m_shadow.textures[StateSampler] == pTexture)
+        return Dropped();
+      m_shadow.textures[StateSampler] = pTexture;
+    }
+    TextureRefPrivate(pTexture, true);
+    auto args = reinterpret_cast<ObjectArgs*>(Allocate(D3D9FrontEndOp::Texture, sizeof(ObjectArgs)));
+    args->object = pTexture;
+    args->a = StateSampler;
+    return D3D_OK;
+  }
