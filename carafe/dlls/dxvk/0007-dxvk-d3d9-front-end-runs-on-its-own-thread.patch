+  HRESULT D3D9FrontEnd::SetIndices(IDirect3DIndexBuffer9* pIndexData) {
+    D3D9IndexBuffer* buffer = static_cast<D3D9IndexBuffer*>(pIndexData);
+    RefPrivate<D3D9IndexBuffer>(buffer, true);
