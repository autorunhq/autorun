+++ b/src/dxvk/dxvk_graphics.cpp
@@ -1097,12 +1097,25 @@
       instance = this->findInstance(state);
 
       if (!instance) {
+        int deferred = this->deferBuild(state);
+
+        if (deferred) {
+          lock.unlock();
+          m_stats->drawsSkipped += 1;
+
+          if (deferred > 1)
+            m_workers->compileGraphicsPipeline(this, state, DxvkPipelinePriority::High);
+
+          return DxvkGraphicsPipelineHandle();
+        }
+
         // Keep pipeline object locked, at worst we're going to stall
         // a state cache worker and the current thread needs priority.
         auto t0 = dxvk::high_resolution_clock::now();
         bool canCreateBasePipeline = this->canCreateBasePipeline(state);
         instance = this->createInstance(state, canCreateBasePipeline);
         auto t1 = dxvk::high_resolution_clock::now();
+        m_builtOnce = true;
 
         // Unlock here since we may dispatch the pipeline to a worker,
         // which will then acquire it to increment the use counter.
@@ -1129,6 +1142,9 @@
 
   void DxvkGraphicsPipeline::compilePipeline(
     const DxvkGraphicsPipelineStateInfo& state) {
+    if (this->compileDeferred(state))
+      return;
+
     if (m_device->config().enableGraphicsPipelineLibrary == Tristate::True)
       return;
 
@@ -1346,6 +1362,75 @@
 
     return true;
   }
+
+
+  bool DxvkGraphicsPipeline::canLinkWithoutWaiting(
+    const DxvkGraphicsPipelineStateInfo& state) const {
+    return m_vsLibrary && m_fsLibrary
+        && this->canCreateBasePipeline(state)
+        && m_vsLibrary->hasPipelineHandle()
+        && m_fsLibrary->hasPipelineHandle();
+  }
+
+
+  int DxvkGraphicsPipeline::deferBuild(
+    const DxvkGraphicsPipelineStateInfo& state) {
+    DxvkShaderCompileMethod method = m_device->config().shaderCompileMethod;
+
+    if (method == DxvkShaderCompileMethod::None
+     || (method == DxvkShaderCompileMethod::Dyasync && !m_builtOnce)
+     || this->canLinkWithoutWaiting(state))
+      return 0;
+
+    for (const auto& entry : m_pending) {
+      if (entry.eq(state))
+        return 1;
+    }
+
+    m_pending.push_back(state);
+    return 2;
+  }
+
+
+  bool DxvkGraphicsPipeline::compileDeferred(
+    const DxvkGraphicsPipelineStateInfo& state) {
+    if (m_device->config().shaderCompileMethod == DxvkShaderCompileMethod::None)
+      return false;
+
+    { std::unique_lock<dxvk::mutex> lock(m_mutex);
+      bool pending = false;
+
+      for (const auto& entry : m_pending)
+        pending |= entry.eq(state);
+
+      if (!pending)
+        return false;
+    }
+
+    VkPipeline pipeline = this->validatePipelineState(state, false)
+      ? this->getOptimizedPipeline(state)
+      : VK_NULL_HANDLE;
+
+    std::unique_lock<dxvk::mutex> lock(m_mutex);
+
+    if (!this->findInstance(state)) {
+      m_stats->numGraphicsPipelines += 1;
+      m_pipelines.add(state, VK_NULL_HANDLE, pipeline, computeAttachmentMask(state));
+      m_builtOnce = true;
+    }
+
+    for (auto entry = m_pending.begin(); entry != m_pending.end(); entry++) {
+      if (entry->eq(state)) {
+        m_pending.erase(entry);
+        break;
+      }
+    }
+
+    if (!pipeline)
+      this->logPipelineState(LogLevel::Error, state);
+
+    return true;
+  }
 
 
