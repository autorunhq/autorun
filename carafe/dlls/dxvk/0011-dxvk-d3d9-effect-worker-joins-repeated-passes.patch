+  bool D3D9FrontEnd::StateBlockHits(D3D9StateBlock* pStateBlock) {
+    D3D9PassFootprint& print = m_open.footprint;
+    if (print.other & PassEverything)
+      return true;
+    D3D9StateCaptures& captures = pStateBlock->m_captures;
+    auto hit = [&] (D3D9FrontEndOp Op, uint32_t A) {
+      return Footprint(print, Op, A, 1, false);
+    };
+    auto any = [] (auto& Set) {
+      for (uint32_t i = 0; i < Set.dwordCount(); i++) {
+        if (Set.dword(i) != 0)
+          return true;
+      }
+      return false;
+    };
+    auto constants = [&] (auto& Set, D3D9FrontEndOp Op) {
+      for (uint32_t i = 0; i < Set.dwordCount(); i++) {
+        for (uint32_t bit : bit::BitMask(Set.dword(i))) {
+          if (hit(Op, i * 32 + bit))
+            return true;
+        }
+      }
+      return false;
+    };
+    const auto& flags = captures.flags;
+    if (flags.test(D3D9CapturedStateFlag::VertexDecl) && hit(D3D9FrontEndOp::VertexDeclaration, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::RenderStates)) {
+      for (uint32_t i = 0; i < captures.renderStates.dwordCount(); i++) {
+        for (uint32_t rs : bit::BitMask(captures.renderStates.dword(i))) {
+          if (hit(D3D9FrontEndOp::RenderState, i * 32 + rs))
+            return true;
+        }
+      }
+    }
+    if (flags.test(D3D9CapturedStateFlag::SamplerStates)) {
+      for (uint32_t sampler : bit::BitMask(captures.samplers.dword(0))) {
+        if (hit(D3D9FrontEndOp::SamplerState, sampler))
+          return true;
+      }
+    }
+    if (flags.test(D3D9CapturedStateFlag::Textures)) {
+      for (uint32_t sampler : bit::BitMask(captures.textures.dword(0))) {
+        if (hit(D3D9FrontEndOp::Texture, sampler))
+          return true;
+      }
+    }
+    if (flags.test(D3D9CapturedStateFlag::TextureStages)) {
+      for (uint32_t stage : bit::BitMask(captures.textureStages.dword(0))) {
+        if (hit(D3D9FrontEndOp::TextureStageState, stage))
+          return true;
+      }
+    }
+    if (flags.test(D3D9CapturedStateFlag::VertexShader) && hit(D3D9FrontEndOp::VertexShader, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::PixelShader) && hit(D3D9FrontEndOp::PixelShader, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::Viewport) && hit(D3D9FrontEndOp::Viewport, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::ScissorRect) && hit(D3D9FrontEndOp::ScissorRect, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::ClipPlanes) && hit(D3D9FrontEndOp::ClipPlane, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::Transforms) && hit(D3D9FrontEndOp::Transform, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::Material) && hit(D3D9FrontEndOp::Material, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::Lights) && hit(D3D9FrontEndOp::Light, 0))
+      return true;
+    if (flags.test(D3D9CapturedStateFlag::VsConstants)) {
+      if (constants(captures.vsConsts.fConsts, D3D9FrontEndOp::VertexConstantsF))
+        return true;
+      if (any(captures.vsConsts.iConsts) && hit(D3D9FrontEndOp::VertexConstantsI, 0))
+        return true;
+      if (any(captures.vsConsts.bConsts) && hit(D3D9FrontEndOp::VertexConstantsB, 0))
+        return true;
+    }
+    if (flags.test(D3D9CapturedStateFlag::PsConstants)) {
+      if (constants(captures.psConsts.fConsts, D3D9FrontEndOp::PixelConstantsF))
+        return true;
+      if (any(captures.psConsts.iConsts) && hit(D3D9FrontEndOp::PixelConstantsI, 0))
+        return true;
+      if (any(captures.psConsts.bConsts) && hit(D3D9FrontEndOp::PixelConstantsB, 0))
+        return true;
+    }
+    return false;
+  }
