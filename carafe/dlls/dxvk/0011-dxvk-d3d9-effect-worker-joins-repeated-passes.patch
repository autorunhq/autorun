+  bool D3D9FrontEnd::Footprint(D3D9PassFootprint& Print, D3D9FrontEndOp Op, uint32_t A, uint32_t Count, bool Mark) {
+    auto flag = [&] (uint32_t& Word, uint32_t Bit) {
+      bool hit = (Word & Bit) != 0 || (Print.other & PassEverything) != 0;
+      if (Mark)
+        Word |= Bit;
+      return hit;
+    };
+    auto bits = [&] (std::bitset<256>& Set) {
+      if (A >= Set.size() || Count > Set.size() - A)
+        return flag(Print.other, PassEverything);
+      bool hit = (Print.other & PassEverything) != 0;
+      for (uint32_t i = A; i < A + Count; i++) {
+        hit |= Set[i];
+        if (Mark)
+          Set[i] = true;
+      }
+      return hit;
+    };
+    switch (Op) {
+      case D3D9FrontEndOp::RenderState:        Count = 1; return bits(Print.renderStates);
+      case D3D9FrontEndOp::SamplerState:
+      case D3D9FrontEndOp::Texture:            return flag(Print.samplers, 1u << (A & 31u));
+      case D3D9FrontEndOp::TextureStageState:  return flag(Print.stages, 1u << (A & 31u));
+      case D3D9FrontEndOp::VertexShader:       return flag(Print.other, 1u << 0);
+      case D3D9FrontEndOp::PixelShader:        return flag(Print.other, 1u << 1);
+      case D3D9FrontEndOp::VertexDeclaration:
+      case D3D9FrontEndOp::Fvf:                return flag(Print.other, 1u << 2);
+      case D3D9FrontEndOp::VertexConstantsF:   return bits(Print.vertexConstants);
+      case D3D9FrontEndOp::PixelConstantsF:    return bits(Print.pixelConstants);
+      case D3D9FrontEndOp::VertexConstantsI:   return flag(Print.other, 1u << 3);
+      case D3D9FrontEndOp::VertexConstantsB:   return flag(Print.other, 1u << 4);
+      case D3D9FrontEndOp::PixelConstantsI:    return flag(Print.other, 1u << 5);
+      case D3D9FrontEndOp::PixelConstantsB:    return flag(Print.other, 1u << 6);
+      case D3D9FrontEndOp::Transform:
+      case D3D9FrontEndOp::MultiplyTransform:  return flag(Print.other, 1u << 7);
+      case D3D9FrontEndOp::Viewport:           return flag(Print.other, 1u << 8);
+      case D3D9FrontEndOp::ScissorRect:        return flag(Print.other, 1u << 9);
+      case D3D9FrontEndOp::Material:           return flag(Print.other, 1u << 10);
+      case D3D9FrontEndOp::Light:
+      case D3D9FrontEndOp::LightEnable:        return flag(Print.other, 1u << 11);
+      case D3D9FrontEndOp::ClipPlane:          return flag(Print.other, 1u << 12);
+      default:                                 return flag(Print.other, PassEverything);
+    }
+  }
