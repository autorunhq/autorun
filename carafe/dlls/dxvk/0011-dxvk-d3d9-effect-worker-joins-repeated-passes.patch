+  void D3D9FrontEnd::ClosePass(D3D9FrontEndOp Op, uint32_t Slot) {
+    m_open.ended = false;
+    void* effect = std::exchange(m_open.effect, nullptr);
+    CallEffect(effect, EffectEndPass, 0, nullptr);
+    m_passBreakOps[std::min<uint32_t>(uint32_t(Op), m_passBreakOps.size() - 1)]++;
+    if (Op == D3D9FrontEndOp::Effect)
+      m_passBreakSlots[std::min<uint32_t>(Slot, m_passBreakSlots.size() - 1)]++;
+  }
