+  HRESULT D3D9FrontEnd::TrackedCall(void* pEffect, uint32_t Slot, uint32_t ArgCount, const uint32_t* pValues,
+      bool& Tracked) {
+    D3D9FrontEnd* downstream = m_downstream;
+    bool track = downstream != nullptr && downstream->Queues() && downstream->m_footprint == nullptr;
+    uint32_t directs = track ? downstream->m_directs : 0u;
+    if (track)
+      downstream->m_footprint = &m_open.footprint;
+    HRESULT hr = CallEffect(pEffect, Slot, ArgCount, pValues);
+    if (track)
+      downstream->m_footprint = nullptr;
+    Tracked = track && downstream->m_directs == directs && downstream->Queues();
+    return hr;
+  }
+
+
+  bool D3D9FrontEnd::EffectPass(void* pEffect, uint32_t Slot, uint32_t ArgCount, const uint32_t* pValues) {
+    bool tracked = false;
+    if (Slot == EffectBeginPass) {
+      if (m_open.ended) {
+        m_open.ended = false;
+        TrackedCall(pEffect, EffectCommit, 0, nullptr, tracked);
+        if (!tracked)
+          m_open.footprint.other |= PassEverything;
+        m_statJoined++;
+        return true;
+      }
+      m_open.effect = nullptr;
+      m_open.footprint = D3D9PassFootprint();
+      HRESULT hr = TrackedCall(pEffect, EffectBeginPass, ArgCount, pValues, tracked);
+      m_statPasses++;
+      if (tracked && SUCCEEDED(hr)) {
+        m_open.effect = pEffect;
+        m_open.pass = pValues[0];
+      }
+      return true;
+    }
+    if (pEffect != m_open.effect)
+      return false;
+    if (Slot == EffectCommit && m_open.ended)
+      return true;
+    if (Slot == EffectEndPass) {
+      m_open.ended = true;
+      return true;
+    }
+    if (Slot < EffectTechnique || Slot == EffectCommit) {
+      TrackedCall(pEffect, Slot, ArgCount, pValues, tracked);
+      if (!tracked)
+        m_open.footprint.other |= PassEverything;
+      return true;
+    }
+    return false;
+  }
