+++ b/src/d3d9/d3d9_effect_hooks.h
@@ -0,0 +1,17 @@
+#pragma once
+
+#include <cstdint>
+
+namespace dxvk {
+
+  class D3D9EffectHooks {
+
+  public:
+
+    static void Install();
+
+    static void Report(uint32_t Frames);
+
+  };
+
+}
