Carafe: DXVK counts the pipelines it builds while drawing, which hold the frame up: every ten seconds one
[DXVK pipelines] line gives how many were built (linked from shader libraries or compiled in full), the time they
took and the longest one, the shader libraries built while drawing and the draws skipped for want of a pipeline.
Zlib, as the files it changes.

diff -ruN a/src/dxvk/dxvk_device.cpp b/src/dxvk/dxvk_device.cpp
--- a/src/dxvk/dxvk_device.cpp
+++ b/src/dxvk/dxvk_device.cpp
@@ -620,6 +620,7 @@
     latencyInfo.frameId = frameId;
 
     m_submissionQueue.present(presentInfo, latencyInfo, status);
+    m_objects.pipelineManager().reportStalls();
     
     std::lock_guard<sync::Spinlock> statLock(m_statLock);
     m_statCounters.addCtr(DxvkStatCounter::QueuePresentCount, 1);
diff -ruN a/src/dxvk/dxvk_graphics.cpp b/src/dxvk/dxvk_graphics.cpp
--- a/src/dxvk/dxvk_graphics.cpp
+++ b/src/dxvk/dxvk_graphics.cpp
@@ -1099,13 +1099,24 @@
       if (!instance) {
         // Keep pipeline object locked, at worst we're going to stall
         // a state cache worker and the current thread needs priority.
+        auto t0 = dxvk::high_resolution_clock::now();
         bool canCreateBasePipeline = this->canCreateBasePipeline(state);
         instance = this->createInstance(state, canCreateBasePipeline);
+        auto t1 = dxvk::high_resolution_clock::now();
 
         // Unlock here since we may dispatch the pipeline to a worker,
         // which will then acquire it to increment the use counter.
         lock.unlock();
 
+        uint64_t us = std::chrono::duration_cast<std::chrono::microseconds>(t1 - t0).count();
+        m_stats->drawBuilds += 1;
+        m_stats->drawBuildUs += us;
+        (instance->baseHandle.load() ? m_stats->drawBuildsLinked : m_stats->drawBuildsFull) += 1;
+
+        uint64_t longest = m_stats->drawBuildMaxUs.load();
+        while (us > longest && !m_stats->drawBuildMaxUs.compare_exchange_weak(longest, us))
+          continue;
+
         // If necessary, compile an optimized pipeline variant
         if (!instance->fastHandle.load())
           m_workers->compileGraphicsPipeline(this, state, DxvkPipelinePriority::Low);
