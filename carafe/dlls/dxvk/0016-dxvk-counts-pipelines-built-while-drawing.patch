@@ -356,6 +358,38 @@
   }
 
 
+  void DxvkPipelineManager::reportStalls() {
+    m_stats.frames += 1;
+
+    int64_t now = std::chrono::duration_cast<std::chrono::microseconds>(
+      dxvk::high_resolution_clock::now().time_since_epoch()).count();
+    int64_t last = m_stats.reportedAt.load();
+
+    if (!last) {
+      m_stats.reportedAt.compare_exchange_strong(last, now);
+      return;
+    }
+
+    if (now - last < 10000000 || !m_stats.reportedAt.compare_exchange_strong(last, now))
+      return;
+
+    uint64_t frames = m_stats.frames.exchange(0u);
+    uint64_t builds = m_stats.drawBuilds.exchange(0u);
+    uint64_t linked = m_stats.drawBuildsLinked.exchange(0u);
+    uint64_t full = m_stats.drawBuildsFull.exchange(0u);
+    uint64_t buildUs = m_stats.drawBuildUs.exchange(0u);
+    uint64_t maxUs = m_stats.drawBuildMaxUs.exchange(0u);
+    uint64_t rebuilds = m_stats.libraryRebuilds.exchange(0u);
+    uint64_t rebuildUs = m_stats.libraryRebuildUs.exchange(0u);
+    uint64_t skipped = m_stats.drawsSkipped.exchange(0u);
+
+    Logger::info(str::format("[DXVK pipelines] ", (now - last) / 1000, " ms, ", frames, " frames: ",
+      builds, " built while drawing (", linked, " linked, ", full, " full) in ", buildUs / 1000,
+      " ms, longest ", maxUs / 1000, " ms; ", rebuilds, " shader libraries rebuilt in ", rebuildUs / 1000,
+      " ms; ", skipped, " draws skipped"));
+  }
+
